---
import Base from '../layouts/Base.astro';
---

<Base title="Metas — Estratégia 2050" description="Acompanhamento do cumprimento das metas da Estratégia Amazônia 2050 na região e em cada estado." ogDescription="Onde a Amazônia Legal já cumpre as metas da Estratégia e onde ainda há distância." mainClass="goals-page" pagina="metas" dados={['metas', 'geo']}>
  <div class="section-shell">
    <section class="goals-head">
      <h1>Metas - <em>Amazônia Legal.</em></h1>
      <p class="lead">Escolha uma meta na lista para ver como a região está e quais estados já a cumprem. Os prazos vão de 2030 a 2050: o que aparece aqui é a posição de hoje.</p>
    </section>

    <div class="goals-board">
      <article class="goals-map-card card">
        <div id="goals-reading" class="goals-reading" aria-live="polite">
          <p class="method-loading">Carregando metas…</p>
        </div>
        <div class="goals-map-canvas">
          <svg id="goals-map" viewBox="0 0 720 500" role="img" aria-label="Mapa da Amazônia Legal com a situação de cada estado na meta selecionada."></svg>
        </div>
        <div class="goals-map-foot">
          <ul class="goals-legend" aria-label="Legenda do mapa">
            <li><i class="is-met" aria-hidden="true"></i>Cumpre a meta</li>
            <li><i class="is-progress" aria-hidden="true"></i>Em curso</li>
            <li><i class="is-empty" aria-hidden="true"></i>Sem dado</li>
          </ul>
          <button type="button" id="goals-clear" class="goals-clear" hidden>Voltar à leitura regional</button>
        </div>
      </article>

      <section class="goals-list-card card" aria-labelledby="goals-list-title">
        <div class="goals-list-head">
          <h2 id="goals-list-title">As metas avaliáveis</h2>
          <p id="goals-list-sub">—</p>
        </div>
        <ol id="goals-list" class="goals-list" aria-label="Metas com patamar mensurável"></ol>
      </section>
    </div>

    <section class="goals-coverage" aria-labelledby="goals-coverage-title">
      <h2 id="goals-coverage-title">O que ainda não é possível avaliar</h2>
      <p id="goals-coverage-lead">—</p>
      <details class="goals-coverage-list">
        <summary>Ver os indicadores fora do quadro e o motivo</summary>
        <div id="goals-excluded"></div>
      </details>
    </section>
  </div>

  <script>
    import '../scripts/metas.js';
  </script>
</Base>
