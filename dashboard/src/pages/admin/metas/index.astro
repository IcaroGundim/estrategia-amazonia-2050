---
// As metas confrontáveis e os motivos das que ficam fora: uma lista por
// situação, com o caminho para editar cada indicador.
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import Mensagens from '../../../components/admin/Mensagens.astro';
import Busca from '../../../components/admin/Busca.astro';
import { leJson } from '../../../lib/admin/edicao';

interface Parametro { codigo: string; alvo?: number | { tipo: string } | null; direcao: string; tipo: string; agregacao?: string }
interface Metas { parametros: Parametro[]; exclusoes: Record<string, string> }
interface Projecao { codigo: string; nome: string; unidade: string; comparavel: boolean; motivo?: string | null; cenarios: { nome: string; serie: Record<string, number> }[] }
interface Catalogo { eixos: { numero: number; nome: string; indicadores: { codigo: string; nome: string; meta: string }[] }[] }

const sessao = Astro.locals.sessao!;
const [{ dados: metas }, { dados: catalogo }, { dados: projecoes }] = await Promise.all([leJson<Metas>('metas'), leJson<Catalogo>('catalogo'), leJson<{ atualizadoEm: string; projecoes: Projecao[] }>('projecoes')]);
const anosDe = (item: Projecao) => { const anos = item.cenarios.flatMap((c) => Object.keys(c.serie)).sort(); return `${anos[0]}–${anos.at(-1)}`; };
const salvo = Astro.url.searchParams.get('salvo');
const indicadores = catalogo.eixos.flatMap((eixo) => eixo.indicadores.map((item) => ({ ...item, eixo: eixo.numero })));
const nomeDe = (codigo: string) => indicadores.find((item) => item.codigo === codigo)?.nome || '';
const avaliadas = new Set(metas.parametros.map((item) => item.codigo));
const excluidas = new Set(Object.keys(metas.exclusoes));
const semNada = indicadores.filter((item) => !avaliadas.has(item.codigo) && !excluidas.has(item.codigo));
const descreveAlvo = (parametro: Parametro) => {
  if (parametro.direcao === 'categoria') return 'parcela dos estados na categoria pedida';
  if (parametro.alvo && typeof parametro.alvo === 'object') return 'alvo calculado sobre a baseline da região';
  return `${parametro.direcao === 'menor' ? 'no máximo' : 'pelo menos'} ${parametro.alvo}`;
};
---

<Admin title="Metas" sessao={sessao}>
  <Mensagens salvo={salvo} />
  <section class="admin-cartao">
    <p class="admin-chapeu"><a href="/admin">Início</a> / Metas</p>
    <h1>Metas confrontáveis</h1>
    <p>Uma meta só entra no quadro quando o patamar pode ser comparado com os valores coletados, na mesma unidade. As demais aparecem na lista pública como "fora do quadro", com o motivo escrito aqui ou com o motivo padrão.</p>
    <p>As metas são da Amazônia Legal como um todo: o que se confronta com o alvo é o valor da região, e os estados aparecem como complemento. Quando a meta não diz a baseline, vale a média dos últimos 10 anos da série regional, ou dos últimos 5 se ela for mais curta.</p>
    <Busca placeholder="Buscar indicador por código ou nome" />
  </section>

  <section class="admin-cartao">
    <h2>No quadro ({metas.parametros.length})</h2>
    <ul class="admin-lista is-compacta">
      {metas.parametros.map((parametro) => (
        <li>
          <div><a href={`/admin/metas/${encodeURIComponent(parametro.codigo)}`}><b>{parametro.codigo}</b> {nomeDe(parametro.codigo)}</a><br /><small>{descreveAlvo(parametro)}, meta {parametro.tipo} {parametro.agregacao || 'sem agregação'}</small></div>
          <span class="admin-etiqueta">avaliada</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="admin-cartao">
    <h2>Fora do quadro, com motivo próprio ({excluidas.size})</h2>
    <ul class="admin-lista is-compacta">
      {[...excluidas].map((codigo) => (
        <li>
          <div><a href={`/admin/metas/${encodeURIComponent(codigo)}`}><b>{codigo}</b> {nomeDe(codigo)}</a><br /><small>{metas.exclusoes[codigo]}</small></div>
          <span class="admin-etiqueta is-pendente">excluída</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="admin-cartao">
    <h2>Fora do quadro, com motivo padrão ({semNada.length})</h2>
    <p>Sem valores coletados ou sem patamar numérico. Abra um para parametrizar a meta ou escrever um motivo específico.</p>
    <ul class="admin-lista is-compacta">
      {semNada.map((item) => (
        <li><div><a href={`/admin/metas/${encodeURIComponent(item.codigo)}`}><b>{item.codigo}</b> {item.nome}</a><br /><small>{item.meta}</small></div></li>
      ))}
    </ul>
  </section>

  <section class="admin-cartao">
    <h2>Trajetórias pactuadas até 2050 ({projecoes.projecoes.length})</h2>
    <p>Metas intermediárias regionais das planilhas de projeção da Estratégia (atualizadas em {projecoes.atualizadoEm}). Só leitura aqui: vêm de <code>conteudo/projecoes.json</code>, gerado por <code>scripts/estrategia_set2026.py</code>. "Comparável" quer dizer que a linha de base é o mesmo número que o painel mede, e só então a página de Metas desenha a série observada sobre a trajetória.</p>
    <ul class="admin-lista is-compacta">
      {projecoes.projecoes.map((item) => (
        <li>
          <div><a href={`/admin/metas/${encodeURIComponent(item.codigo)}`}><b>{item.codigo}</b> {item.nome}</a><br /><small>{item.cenarios.map((c) => c.nome).join(', ')} · {anosDe(item)} · {item.unidade}{item.motivo ? ` · ${item.motivo}` : ''}</small></div>
          <span class={`admin-etiqueta${item.comparavel ? '' : ' is-pendente'}`}>{item.comparavel ? 'comparável' : 'só referência'}</span>
        </li>
      ))}
    </ul>
  </section>
</Admin>
