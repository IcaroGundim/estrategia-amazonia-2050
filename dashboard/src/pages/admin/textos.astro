---
// Textos do painel: cada par { pt, en } de conteudo/textos.json vira um campo
// bilíngue, agrupado pela lâmina. A tela anda pela estrutura do arquivo, então
// um texto novo no JSON aparece aqui sem mudar código.
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import Campo from '../../components/admin/Campo.astro';
import Mensagens from '../../components/admin/Mensagens.astro';
import { ErroDeEdicao, leJson, salvaJson, texto, textoOuNulo } from '../../lib/admin/edicao';

type Par = { pt: string; en?: string | null };
type Arvore = { [chave: string]: unknown };

const sessao = Astro.locals.sessao!;
const lido = await leJson<Arvore>('textos');
let erro: string | null = null;
let versao = lido.versao;
const salvo = Astro.url.searchParams.get('salvo');

const ehPar = (valor: unknown): valor is Par => typeof valor === 'object' && valor !== null && 'pt' in valor && typeof (valor as Par).pt === 'string';

// Cada folha { pt, en } com o caminho até ela, ex.: visaoGeral.temas.itens.2.titulo
function folhas(no: unknown, caminho: string[] = []): { caminho: string; par: Par }[] {
  if (ehPar(no)) return [{ caminho: caminho.join('.'), par: no }];
  if (Array.isArray(no)) return no.flatMap((item, indice) => folhas(item, [...caminho, String(indice)]));
  if (typeof no === 'object' && no !== null) {
    return Object.entries(no).filter(([chave]) => !chave.startsWith('_')).flatMap(([chave, valor]) => folhas(valor, [...caminho, chave]));
  }
  return [];
}

function poe(no: unknown, caminho: string[], par: Par) {
  const [cabeca, ...resto] = caminho;
  const alvo = no as { [k: string]: unknown };
  if (!resto.length) { alvo[cabeca] = { ...(alvo[cabeca] as object), ...par }; return; }
  poe(alvo[cabeca], resto, par);
}

const GRUPOS: { chave: string; titulo: string; descricao: string }[] = [
  { chave: 'visaoGeral.estrategia', titulo: 'Visão Geral · lâmina 1 — A Estratégia', descricao: 'Título, abertura, os três números e o fechamento.' },
  { chave: 'visaoGeral.visao2050', titulo: 'Visão Geral · lâmina 2 — Visão 2050', descricao: 'A visão regional e como a Estratégia auxilia os estados.' },
  { chave: 'visaoGeral.temas', titulo: 'Visão Geral · lâmina 3 — Temas estratégicos', descricao: 'Os seis temas.' },
  { chave: 'visaoGeral.governanca', titulo: 'Visão Geral · lâmina 4 — Governança', descricao: 'Os seis blocos e o fluxo de implementação.' },
  { chave: 'visaoGeral.estePainel', titulo: 'Visão Geral · lâmina 5 — Este painel', descricao: 'Como os dados são lidos.' },
  { chave: 'panorama.metodologia', titulo: 'Panorama · metodologia da síntese', descricao: 'Título, texto, dimensões e fontes consolidadas, exibidos no Panorama e na lâmina 5.' }
];

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  versao = texto(dados, 'versao') || versao;
  try {
    await salvaJson<Arvore>('textos', versao, (textos) => {
      for (const { caminho, par } of folhas(textos)) {
        const nome = `t:${caminho}`;
        if (!dados.has(nome)) continue;
        const pt = texto(dados, nome);
        if (!pt) throw new ErroDeEdicao(`O texto em português de "${caminho}" não pode ficar vazio.`);
        poe(textos, caminho.split('.'), { pt, en: textoOuNulo(dados, `${nome}__en`) ?? par.en ?? null });
      }
      return textos;
    }, 'edita os textos do painel', { usuario: sessao.usuario, nome: sessao.nome });
    return Astro.redirect('/admin/textos?salvo=1', 303);
  } catch (falha) {
    erro = falha instanceof ErroDeEdicao ? falha.message : `Não consegui salvar: ${(falha as Error).message}`;
  }
}

const todas = folhas(lido.dados);
const rotuloDe = (caminho: string) => caminho.split('.').slice(-2).map((parte) => (/^\d+$/.test(parte) ? `item ${Number(parte) + 1}` : parte)).join(' · ');
---

<Admin title="Textos" sessao={sessao}>
  <section class="admin-cartao">
    <p class="admin-chapeu"><a href="/admin">Início</a> · Textos</p>
    <h1>Textos do painel</h1>
    <p>Português à esquerda, inglês à direita. Um inglês vazio faz a página em inglês mostrar o português naquele ponto. Os textos de interface (botões, menus, rótulos) não estão aqui; vivem no código.</p>
    <Mensagens erro={erro} salvo={salvo ? 'Salvo no rascunho.' : null} />
  </section>

  <form method="post">
    <input type="hidden" name="versao" value={versao} />
    {GRUPOS.map((grupo) => {
      const campos = todas.filter((folha) => folha.caminho.startsWith(`${grupo.chave}.`));
      return (
        <section class="admin-cartao">
          <h2>{grupo.titulo}</h2>
          <p>{grupo.descricao}</p>
          <div class="admin-form">
            {campos.map(({ caminho, par }) => (
              <Campo nome={`t:${caminho}`} rotulo={rotuloDe(caminho)} valor={par.pt} en={par.en} comEn tipo={par.pt.length > 90 ? 'area' : 'texto'} linhas={Math.min(8, Math.ceil(par.pt.length / 110) + 1)} largo />
            ))}
          </div>
        </section>
      );
    })}
    <section class="admin-cartao">
      <div class="admin-acoes">
        <button type="submit" class="admin-botao">Salvar no rascunho</button>
        <a class="admin-botao is-secundario" href="/admin">Voltar</a>
      </div>
    </section>
  </form>
</Admin>
