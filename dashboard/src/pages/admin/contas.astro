---
// Contas: quem pode entrar na administração. Criar mostra a senha temporária
// uma única vez; redefinir gera outra; desativar tira o acesso. As mudanças
// vão direto para a branch principal e valem no deploy seguinte.
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import Campo from '../../components/admin/Campo.astro';
import Mensagens from '../../components/admin/Mensagens.astro';
import { ErroDeEdicao, texto } from '../../lib/admin/edicao';
import { ativaConta, criaConta, leContas, redefineSenha } from '../../lib/admin/contas';

const sessao = Astro.locals.sessao!;
const autor = { usuario: sessao.usuario, nome: sessao.nome };
let erro: string | null = null;
let aviso: string | null = null;
let senhaMostrada: { usuario: string; senha: string } | null = null;

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  const acao = texto(dados, 'acao');
  const usuario = texto(dados, 'usuario');
  try {
    if (acao === 'criar') {
      const senha = await criaConta(usuario, texto(dados, 'nome'), autor);
      senhaMostrada = { usuario: usuario.trim().toLowerCase(), senha };
    } else if (acao === 'redefinir') {
      senhaMostrada = { usuario, senha: await redefineSenha(usuario, autor) };
    } else if (acao === 'desativar' || acao === 'reativar') {
      await ativaConta(usuario, acao === 'reativar', autor);
      aviso = `Conta ${usuario} ${acao === 'reativar' ? 'reativada' : 'desativada'}. Vale a partir do próximo deploy.`;
    }
  } catch (falha) {
    erro = falha instanceof ErroDeEdicao ? falha.message : `Não consegui gravar: ${(falha as Error).message}`;
  }
}

const { dados } = await leContas();
---

<Admin title="Contas" sessao={sessao}>
  <section class="admin-cartao">
    <p class="admin-chapeu"><a href="/admin">Início</a> · Contas</p>
    <h1>Contas da administração</h1>
    <p>Cada pessoa entra com a própria conta, e o histórico registra quem salvou o quê. Contas não passam pelo rascunho: valem a partir do deploy seguinte, em 1 a 2 minutos. A senha temporária aparece uma única vez; passe-a à pessoa e peça que a troque em "Minha senha".</p>
    <Mensagens erro={erro} aviso={aviso} />
    {senhaMostrada && (
      <p class="admin-ok"><b>Senha temporária de {senhaMostrada.usuario}:</b> <code>{senhaMostrada.senha}</code> — copie agora; ela não será mostrada de novo.</p>
    )}
  </section>

  <section class="admin-cartao">
    <h2>Criar conta</h2>
    <form class="admin-form" method="post">
      <input type="hidden" name="acao" value="criar" />
      <div class="admin-form-linha">
        <Campo nome="usuario" rotulo="Usuário" ajuda="Letras minúsculas, números, ponto, hífen ou sublinhado. Ex.: maria.silva" obrigatorio />
        <Campo nome="nome" rotulo="Nome" ajuda="Como aparece no histórico de alterações" obrigatorio />
      </div>
      <div class="admin-acoes"><button type="submit" class="admin-botao">Criar e gerar senha</button></div>
    </form>
  </section>

  <section class="admin-cartao">
    <h2>Contas existentes ({dados.usuarios.length})</h2>
    <ul class="admin-lista">
      {dados.usuarios.map((conta) => (
        <li>
          <div><b>{conta.nome}</b> <small>· {conta.usuario} · desde {conta.criadoEm}{conta.trocarSenha ? ' · senha temporária' : ''}</small></div>
          <div class="admin-acoes" style="margin: 0">
            <span class={`admin-etiqueta${conta.ativo ? ' is-coletado' : ' is-manual'}`}>{conta.ativo ? 'ativa' : 'inativa'}</span>
            <form method="post" onsubmit={`return confirm('Gerar senha nova para ${conta.usuario}? A atual deixa de valer no próximo deploy.')`}><input type="hidden" name="acao" value="redefinir" /><input type="hidden" name="usuario" value={conta.usuario} /><button type="submit" class="admin-botao is-secundario is-mini">Redefinir senha</button></form>
            {conta.usuario !== sessao.usuario && (
              <form method="post"><input type="hidden" name="acao" value={conta.ativo ? 'desativar' : 'reativar'} /><input type="hidden" name="usuario" value={conta.usuario} /><button type="submit" class={`admin-botao is-mini ${conta.ativo ? 'is-perigo' : 'is-secundario'}`}>{conta.ativo ? 'Desativar' : 'Reativar'}</button></form>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Admin>
