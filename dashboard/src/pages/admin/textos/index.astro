---
// Textos do painel, todos numa tela: as lâminas da Visão Geral e a metodologia
// (conteudo/textos.json) e os textos fixos de interface de cada página
// (conteudo/interface.json). Um seletor escolhe a página pública; o quadro
// mostra essa página com o que está no formulário e a lista ao lado traz só
// os grupos de texto que aparecem nela.
export const prerender = false;

import Admin from '../../../layouts/Admin.astro';
import Campo from '../../../components/admin/Campo.astro';
import Mensagens from '../../../components/admin/Mensagens.astro';
import { ErroDeEdicao, leJson, salvaJson, texto } from '../../../lib/admin/edicao';
import { GRUPOS, NOME_DA_PAGINA, aplicaFormulario, aplicaFormularioInterface, folhas, lacunasDe, nomeDeInterface, pertenceAoGrupo, type Arvore, type Interface } from '../../../lib/admin/textos';

type Pagina = keyof typeof NOME_DA_PAGINA;
const PAGINAS = Object.keys(NOME_DA_PAGINA) as Pagina[];

const sessao = Astro.locals.sessao!;
const [textosLidos, interfaceLida] = await Promise.all([leJson<Arvore>('textos'), leJson<Interface>('interface')]);
let erro: string | null = null;
let versaoTextos = textosLidos.versao;
let versaoInterface = interfaceLida.versao;
const salvo = Astro.url.searchParams.get('salvo');
const pedida = Astro.url.searchParams.get('pagina');
const paginaInicial: Pagina = PAGINAS.includes(pedida as Pagina) ? (pedida as Pagina) : 'metodologia';

// O que o formulário mostra: o rascunho gravado ou, se a gravação falhou, o
// que a pessoa tinha digitado, para não perder a edição junto com o erro.
let textosNaTela = textosLidos.dados;
let interfaceNaTela = interfaceLida.dados;

if (Astro.request.method === 'POST') {
  const dados = await Astro.request.formData();
  versaoTextos = texto(dados, 'versaoTextos') || versaoTextos;
  versaoInterface = texto(dados, 'versaoInterface') || versaoInterface;
  const autor = { usuario: sessao.usuario, nome: sessao.nome };
  const mudou = (antes: unknown, depois: unknown) => JSON.stringify(antes) !== JSON.stringify(depois);
  try {
    // Cada arquivo só é gravado se algum campo dele mudou de fato.
    if (mudou(textosLidos.dados, aplicaFormulario(structuredClone(textosLidos.dados), dados))) {
      await salvaJson<Arvore>('textos', versaoTextos, (textos) => aplicaFormulario(textos, dados), 'edita os textos do painel', autor);
    }
    if (mudou(interfaceLida.dados, aplicaFormularioInterface(structuredClone(interfaceLida.dados), dados))) {
      await salvaJson<Interface>('interface', versaoInterface, (dicionario) => aplicaFormularioInterface(dicionario, dados), 'edita os textos de interface', autor);
    }
    return Astro.redirect(`/admin/textos?salvo=1&pagina=${texto(dados, 'pagina') || paginaInicial}`, 303);
  } catch (falha) {
    erro = falha instanceof ErroDeEdicao ? falha.message : `Não consegui salvar: ${(falha as Error).message}`;
    textosNaTela = aplicaFormulario(structuredClone(textosLidos.dados), dados, { estrito: false });
    interfaceNaTela = aplicaFormularioInterface(structuredClone(interfaceLida.dados), dados, { estrito: false });
  }
}

const todas = folhas(textosNaTela);
const rotuloDe = (caminho: string) => caminho.split('.').slice(-2).map((parte) => (/^\d+$/.test(parte) ? `item ${Number(parte) + 1}` : parte)).join(' / ');
const rotuloDeChave = (chave: string) => (chave.length > 64 ? `${chave.slice(0, 61)}...` : chave);
const { grupos: gruposInterface, textos: interfaceTextos } = interfaceNaTela;
---

<Admin title="Textos" sessao={sessao}>
  <Mensagens erro={erro} salvo={salvo ? 'Salvo no rascunho.' : null} />

  <form method="post" class="admin-textos" data-textos-form data-com-erro={erro ? '' : undefined} data-astro-reload>
    <input type="hidden" name="versaoTextos" value={versaoTextos} />
    <input type="hidden" name="versaoInterface" value={versaoInterface} />
    <input type="hidden" name="pagina" value={paginaInicial} data-pagina-atual />
    <button type="submit" hidden tabindex="-1" formnovalidate formtarget="previa-quadro" formaction={`/admin/textos/previa?pagina=${paginaInicial}`} data-botao-previa>Atualizar a prévia</button>

    <div class="admin-textos-barra">
      <span class="admin-seletor" role="group" aria-label="Página do painel">
        {PAGINAS.map((pagina) => (
          <button type="button" class={pagina === paginaInicial ? 'is-ativo' : undefined} aria-pressed={pagina === paginaInicial ? 'true' : 'false'} data-escolhe-pagina={pagina}>{NOME_DA_PAGINA[pagina]}</button>
        ))}
      </span>
      <span class="admin-seletor" role="group" aria-label="Idioma">
        <button type="button" class="is-ativo" data-previa-lang="pt-BR" aria-pressed="true">Português</button>
        <button type="button" data-previa-lang="en" aria-pressed="false">English</button>
      </span>
      <span class="admin-previa-estado" data-previa-estado aria-live="polite"></span>
      <div class="admin-busca">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        <input type="search" placeholder="Filtrar textos" autocomplete="off" aria-label="Filtrar os textos" data-filtro />
        <small data-filtro-resumo></small>
      </div>
      <button type="submit" class="admin-botao">Salvar no rascunho</button>
    </div>

    <div class="admin-textos-corpo">
      <div class="admin-textos-lista">
        <div class="admin-grupos-nav">
          <button type="button" class="admin-grupos-seta" data-grupo-anterior aria-label="Grupo anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
          <div class="admin-grupos-menu" data-grupo-menu>
            <button type="button" class="admin-grupos-gatilho" aria-haspopup="listbox" aria-expanded="false" aria-label="Grupo de textos" data-grupo-gatilho>
              <span class="admin-grupos-num" data-grupo-num></span>
              <span class="admin-grupos-rotulo" data-grupo-rotulo></span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <ul class="admin-grupos-lista" role="listbox" aria-label="Grupos de textos" tabindex="-1" hidden data-grupo-lista></ul>
          </div>
          <span class="admin-grupos-contador" data-grupo-contador></span>
          <button type="button" class="admin-grupos-seta" data-grupo-proximo aria-label="Próximo grupo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        </div>
        {GRUPOS.map((grupo) => {
          const campos = todas.filter((folha) => pertenceAoGrupo(grupo, folha.caminho));
          return (
            <section class="admin-cartao" data-grupo data-pagina="metodologia" data-secao={grupo.secao} data-ancora={grupo.ancora} data-fonte="textos" hidden={paginaInicial !== 'metodologia'}>
              <h2>{grupo.titulo}</h2>
              <p>{grupo.descricao}</p>
              <div class="admin-form">
                {campos.map(({ caminho, par }) => (
                  <Campo nome={`t:${caminho}`} rotulo={rotuloDe(caminho)} valor={par.pt} en={par.en} comEn tipo={par.pt.length > 90 ? 'area' : 'texto'} linhas={Math.min(8, Math.ceil(par.pt.length / 110) + 1)} largo />
                ))}
              </div>
            </section>
          );
        })}
        {gruposInterface.map((grupo) => (
          <section class="admin-cartao" data-grupo data-pagina={grupo.pagina} data-secao="Textos de interface" data-fonte="interface" data-alvo={grupo.alvo} data-abre={grupo.abre} hidden={paginaInicial !== grupo.pagina}>
            <h2>{grupo.titulo}</h2>
            <div class="admin-form">
              {grupo.chaves.map((chave) => {
                const par = interfaceTextos[chave];
                const longo = par.pt.length > 80 || (par.en || '').length > 80;
                const lacunas = lacunasDe(chave);
                const ajuda = lacunas.length ? `${lacunas.join(', ')} ${lacunas.length === 1 ? 'é trocado' : 'são trocados'} pelo valor na página. Mantenha nos dois idiomas; a posição na frase pode mudar.` : undefined;
                return (
                  <Campo nome={nomeDeInterface(chave)} rotulo={rotuloDeChave(chave)} valor={par.pt} en={par.en} comEn tipo={longo ? 'area' : 'texto'} linhas={Math.min(6, Math.ceil(par.pt.length / 90) + 1)} ajuda={ajuda} largo />
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <aside class="admin-previa" aria-label="Prévia da página">
        <div class="admin-previa-moldura" data-previa-moldura>
          <iframe name="previa-quadro" src={`/admin/textos/previa?pagina=${paginaInicial}`} width="1280" height="820" title="Prévia da página com os textos do rascunho" data-previa-quadro></iframe>
        </div>
      </aside>
    </div>
  </form>
</Admin>

<script>
  function inicia() {
    const form = document.querySelector<HTMLFormElement>('[data-textos-form]');
    const botao = document.querySelector<HTMLButtonElement>('[data-botao-previa]');
    const quadro = document.querySelector<HTMLIFrameElement>('[data-previa-quadro]');
    const estado = document.querySelector<HTMLElement>('[data-previa-estado]');
    const campoPagina = document.querySelector<HTMLInputElement>('[data-pagina-atual]');
    if (!form || !botao || !quadro || !estado || !campoPagina) return;

    let lang = 'pt-BR';
    let pagina = campoPagina.value;
    let temporizador: number | undefined;
    let pedido = 0;
    const grupos = [...form.querySelectorAll<HTMLElement>('[data-grupo]')];

    // ---- prévia: a própria página pública, no quadro ----
    // O aviso ao lado da barra: enquanto o quadro se refaz, um anel gira antes
    // do texto; erro fica parado.
    function mostraEstado(texto: string, ocupado = false) {
      estado.textContent = texto;
      estado.classList.toggle('is-ocupado', ocupado);
    }
    // Recarrega o quadro enviando o formulário para ele (botão escondido).
    // O endereço vai sem `#lâmina`: carregar o quadro numa âncora faz o
    // navegador rolar também a página de fora até o quadro. A lâmina aberta é
    // reposta depois do carregamento, em `mostraNoQuadro`, que não rola nada.
    function recarrega() {
      botao.formAction = `/admin/textos/previa?pagina=${pagina}&lang=${lang}`;
      mostraEstado('atualizando', true);
      form.requestSubmit(botao);
    }
    quadro.addEventListener('load', () => {
      mostraEstado('');
      // Ao recarregar o quadro, volta ao trecho do grupo aberto (as páginas
      // com script precisam de um instante para montar o conteúdo).
      window.setTimeout(() => mostraNoQuadro(atual), 400);
    });

    // Nas lâminas da Visão Geral dá para trocar só o texto, sem recarregar:
    // a lâmina aberta e a rolagem ficam como estão. Os textos da nota técnica
    // não aparecem em página nenhuma, então nem vale a ida ao servidor.
    async function trocaTextoDasLaminas() {
      const doc = quadro.contentDocument;
      if (!doc || !doc.querySelector('.method-section')) return recarrega();
      const meu = ++pedido;
      mostraEstado('atualizando', true);
      try {
        const resposta = await fetch(`/admin/textos/previa?pagina=metodologia&lang=${lang}`, { method: 'POST', body: new FormData(form) });
        if (!resposta.ok) throw new Error(String(resposta.status));
        const novo = new DOMParser().parseFromString(await resposta.text(), 'text/html');
        if (meu !== pedido) return;
        const atuais = [...doc.querySelectorAll('.method-section')];
        novo.querySelectorAll('.method-section').forEach((secao, indice) => {
          const de = secao.querySelector('.slide-copy');
          const para = atuais[indice]?.querySelector('.slide-copy');
          if (de && para) para.innerHTML = de.innerHTML;
        });
        valorNoQuadro.clear();
        for (const campo of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-fonte="textos"] input, [data-fonte="textos"] textarea')) valorNoQuadro.set(campo.name, campo.value.trim());
        mostraEstado('');
      } catch {
        if (meu === pedido) mostraEstado('a prévia não respondeu');
      }
    }

    // Nas lâminas, a tecla aparece no quadro na hora, sem servidor: o texto que
    // o campo tinha antes é procurado na lâmina do grupo e trocado pelo novo.
    // O servidor confirma logo depois (inglês vazio caindo no português, etc.).
    const valorNoQuadro = new Map<string, string>();
    function trocaNaHora(campo: HTMLInputElement | HTMLTextAreaElement, grupo: HTMLElement) {
      const doc = quadro.contentDocument;
      const ancora = grupo.dataset.ancora;
      if (!doc || !ancora) return false;
      const emIngles = campo.name.endsWith('__en');
      if (emIngles !== (lang === 'en')) return false;
      const antes = (valorNoQuadro.get(campo.name) ?? campo.defaultValue).trim();
      const depois = campo.value.trim();
      if (!antes || !depois) return false;
      const secao = doc.querySelector(`#${ancora} .slide-copy`);
      if (!secao) return false;
      const passeio = doc.createTreeWalker(secao, NodeFilter.SHOW_TEXT);
      let no: Text | null;
      while ((no = passeio.nextNode() as Text | null)) {
        if (no.nodeValue?.trim() === antes) {
          no.nodeValue = no.nodeValue.replace(antes, depois);
          valorNoQuadro.set(campo.name, depois);
          return true;
        }
      }
      return false;
    }

    let ultimaFonte = 'interface';
    form.addEventListener('input', (evento) => {
      const campo = evento.target as HTMLInputElement | HTMLTextAreaElement;
      const grupo = campo.closest<HTMLElement>('[data-grupo]');
      if (!grupo) return;
      ultimaFonte = grupo.dataset.fonte || 'interface';
      if (grupo.dataset.secao === 'Nota técnica') return;
      const laminas = ultimaFonte === 'textos' && pagina === 'metodologia';
      const jaTrocou = laminas && trocaNaHora(campo, grupo);
      window.clearTimeout(temporizador);
      // Com a troca feita na hora, a confirmação pelo servidor pode esperar mais.
      temporizador = window.setTimeout(() => (laminas ? trocaTextoDasLaminas() : recarrega()), jaTrocou ? 900 : (laminas ? 250 : 400));
    });

    // Leva o quadro à lâmina pedida. Não muda location.hash: a navegação
    // nativa por âncora rola também a página de fora para mostrar o alvo, e
    // isso sacudia a tela inteira. Só a rota é trocada, e o script das
    // lâminas, que escuta hashchange, faz a troca dentro do quadro.
    function vaiParaLamina(ancora: string | undefined) {
      const janela = quadro.contentWindow;
      if (!ancora || !janela || pagina !== 'metodologia') return;
      if (janela.location.hash === `#${ancora}`) return;
      // Com a rota já trocada, o clique no índice das lâminas anda suave e
      // não empilha entrada no histórico.
      janela.history.replaceState(null, '', `#${ancora}`);
      const link = janela.document.querySelector<HTMLAnchorElement>(`.methodology-index nav a[href="#${ancora}"]`);
      if (link) link.click(); else janela.dispatchEvent(new Event('hashchange'));
    }

    // Nas outras páginas, rola o quadro até o trecho onde o grupo aparece e o
    // realça por um instante. A rolagem é da janela do quadro, e não
    // scrollIntoView, para não arrastar a página de fora junto.
    let realce: number | undefined;
    function vaiParaTrecho(grupo: HTMLElement | null) {
      const janela = quadro.contentWindow;
      const seletor = grupo?.dataset.alvo;
      if (!janela || !seletor || pagina === 'metodologia') return;
      const doc = janela.document;
      let alvo = doc.querySelector<HTMLElement>(seletor);
      if ((!alvo || alvo.hidden) && grupo?.dataset.abre) {
        doc.querySelector<HTMLElement>(grupo.dataset.abre)?.click();
        alvo = doc.querySelector<HTMLElement>(seletor);
      }
      if (!alvo) return;
      const topo = alvo.getBoundingClientRect().top + janela.scrollY - 88;
      janela.scrollTo({ top: Math.max(0, topo), behavior: 'smooth' });
      doc.querySelectorAll('.is-realce-previa').forEach((outro) => outro.classList.remove('is-realce-previa'));
      alvo.classList.add('is-realce-previa');
      window.clearTimeout(realce);
      realce = window.setTimeout(() => alvo?.classList.remove('is-realce-previa'), 1600);
    }

    function mostraNoQuadro(grupo: HTMLElement | null) {
      if (pagina === 'metodologia') vaiParaLamina(grupo?.dataset.ancora);
      else vaiParaTrecho(grupo);
    }

    // O campo em foco leva o quadro ao trecho certo.
    form.addEventListener('focusin', (evento) => {
      mostraNoQuadro((evento.target as HTMLElement).closest<HTMLElement>('[data-grupo]'));
    });

    // ---- seletor de página ----
    function mostraPagina(nova: string) {
      pagina = nova;
      campoPagina.value = nova;
      document.querySelectorAll<HTMLButtonElement>('[data-escolhe-pagina]').forEach((opcao) => {
        const ativa = opcao.dataset.escolhePagina === nova;
        opcao.classList.toggle('is-ativo', ativa);
        opcao.setAttribute('aria-pressed', String(ativa));
      });
      filtra();
      escala();
      const url = new URL(location.href);
      url.searchParams.set('pagina', nova);
      url.searchParams.delete('salvo');
      history.replaceState(null, '', url);
      recarrega();
    }
    document.querySelectorAll<HTMLButtonElement>('[data-escolhe-pagina]').forEach((opcao) => {
      opcao.addEventListener('click', () => { if (opcao.dataset.escolhePagina !== pagina) mostraPagina(opcao.dataset.escolhePagina || 'metodologia'); });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-previa-lang]').forEach((opcao) => {
      opcao.addEventListener('click', () => {
        lang = opcao.dataset.previaLang || 'pt-BR';
        document.querySelectorAll<HTMLButtonElement>('[data-previa-lang]').forEach((outra) => {
          const ativa = outra === opcao;
          outra.classList.toggle('is-ativo', ativa);
          outra.setAttribute('aria-pressed', String(ativa));
        });
        recarrega();
      });
    });

    // ---- quadro desenhado em 1280px e reduzido para caber ----
    const moldura = quadro.parentElement as HTMLElement;
    // As lâminas têm altura fixa; as outras páginas rolam dentro do quadro.
    function escala() {
      const fator = moldura.clientWidth / 1280;
      const altura = pagina === 'metodologia' ? 690 : 820;
      quadro.height = String(altura);
      quadro.style.transform = `scale(${fator})`;
      moldura.style.height = `${Math.round(altura * fator)}px`;
    }
    escala();
    new ResizeObserver(escala).observe(moldura);

    // ---- um grupo por vez, como lâminas ----
    // O filtro esconde os campos que não casam; a navegação anda só pelos
    // grupos da página escolhida que ainda têm algum campo à mostra.
    const filtro = document.querySelector<HTMLInputElement>('[data-filtro]');
    const resumo = document.querySelector<HTMLElement>('[data-filtro-resumo]');
    const menu = document.querySelector<HTMLElement>('[data-grupo-menu]');
    const gatilho = document.querySelector<HTMLButtonElement>('[data-grupo-gatilho]');
    const listaMenu = document.querySelector<HTMLUListElement>('[data-grupo-lista]');
    const numGatilho = document.querySelector<HTMLElement>('[data-grupo-num]');
    const rotuloGatilho = document.querySelector<HTMLElement>('[data-grupo-rotulo]');
    const contador = document.querySelector<HTMLElement>('[data-grupo-contador]');
    const anterior = document.querySelector<HTMLButtonElement>('[data-grupo-anterior]');
    const proximo = document.querySelector<HTMLButtonElement>('[data-grupo-proximo]');
    const semAcento = (valor: string) => valor.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    let atual: HTMLElement | null = null;
    let candidatos: HTMLElement[] = [];

    function mostraGrupo(grupo: HTMLElement | null) {
      if (grupo && grupo !== atual) {
        grupo.classList.remove('is-entrando');
        void grupo.offsetWidth;
        grupo.classList.add('is-entrando');
      }
      atual = grupo;
      grupos.forEach((item) => { item.hidden = item !== atual; });
      const indice = atual ? candidatos.indexOf(atual) : -1;
      const descrito = atual ? descreve(atual) : null;
      if (numGatilho) { numGatilho.textContent = descrito?.num || ''; numGatilho.hidden = !descrito?.num; }
      if (rotuloGatilho) rotuloGatilho.textContent = descrito?.nome || 'Nenhum grupo';
      listaMenu?.querySelectorAll<HTMLElement>('[role="option"]').forEach((opcao) => {
        opcao.setAttribute('aria-selected', String(Number(opcao.dataset.indice) === indice));
      });
      if (contador) contador.textContent = candidatos.length ? `${indice + 1} / ${candidatos.length}` : '0 / 0';
      if (anterior) anterior.disabled = indice <= 0;
      if (proximo) proximo.disabled = indice < 0 || indice >= candidatos.length - 1;
      mostraNoQuadro(atual);
      // Se a barra de navegação dos grupos ficou acima da tela, volta até ela.
      const nav = document.querySelector<HTMLElement>('.admin-grupos-nav');
      if (nav && nav.getBoundingClientRect().top < 0) nav.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function filtra() {
      const termo = semAcento(filtro?.value.trim() || '');
      let visiveis = 0;
      let total = 0;
      candidatos = [];
      grupos.forEach((grupo) => {
        if (grupo.dataset.pagina !== pagina) return;
        let algum = false;
        grupo.querySelectorAll<HTMLElement>('.admin-campo').forEach((campo) => {
          total += 1;
          const conteudo = semAcento([campo.querySelector('span')?.textContent || '', ...[...campo.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].map((controle) => controle.value)].join(' '));
          const mostra = !termo || conteudo.includes(termo);
          campo.hidden = !mostra;
          if (mostra) { algum = true; visiveis += 1; }
        });
        if (algum) candidatos.push(grupo);
      });
      if (resumo) resumo.textContent = termo ? `${visiveis} de ${total}` : '';
      montaMenu();
      mostraGrupo(atual && candidatos.includes(atual) ? atual : candidatos[0] || null);
    }

    // ---- menu dos grupos ----
    // "Lâmina 3: Temas" vira número + nome; nos demais sai o prefixo com o nome
    // da seção ou da própria página ("Nota técnica: ...", "Panorama: ..."), que
    // ali só repete. A seção vem do cartão (data-secao).
    const NOME_DA_PAGINA: Record<string, string> = { index: 'Panorama', metas: 'Metas e indicadores', metodologia: 'Visão Geral' };
    const maiuscula = (valor: string) => valor.charAt(0).toUpperCase() + valor.slice(1);
    function descreve(grupo: HTMLElement) {
      const titulo = grupo.querySelector('h2')?.textContent?.trim() || '';
      const secao = grupo.dataset.secao || 'Textos de interface';
      const lamina = titulo.match(/^Lâmina (\d+):\s*(.*)$/);
      if (lamina) return { secao, num: lamina[1], nome: maiuscula(lamina[2]) };
      const prefixo = [secao, NOME_DA_PAGINA[pagina] || ''].map((parte) => `${parte}: `).find((parte) => titulo.startsWith(parte));
      const nome = prefixo ? maiuscula(titulo.slice(prefixo.length)) : titulo;
      return { secao, num: '', nome };
    }

    function montaMenu() {
      if (!listaMenu) return;
      listaMenu.innerHTML = '';
      const secoes = new Set(candidatos.map((grupo) => descreve(grupo).secao));
      let ultima = '';
      candidatos.forEach((grupo, indice) => {
        const { secao, num, nome } = descreve(grupo);
        if (secoes.size > 1 && secao !== ultima) {
          const titulo = document.createElement('li');
          titulo.className = 'admin-grupos-secao';
          titulo.setAttribute('role', 'presentation');
          titulo.textContent = secao;
          listaMenu.append(titulo);
          ultima = secao;
        }
        const campos = [...grupo.querySelectorAll<HTMLElement>('.admin-campo')].filter((campo) => !campo.hidden).length;
        const opcao = document.createElement('li');
        opcao.setAttribute('role', 'option');
        opcao.tabIndex = -1;
        opcao.dataset.indice = String(indice);
        const marca = document.createElement('span');
        marca.className = 'admin-grupos-num';
        marca.textContent = num;
        if (!num) marca.classList.add('is-vazio');
        const texto = document.createElement('span');
        texto.className = 'admin-grupos-nome';
        texto.textContent = nome;
        const conta = document.createElement('small');
        conta.textContent = `${campos} ${campos === 1 ? 'campo' : 'campos'}`;
        opcao.append(marca, texto, conta);
        listaMenu.append(opcao);
      });
    }

    const opcoes = () => [...(listaMenu?.querySelectorAll<HTMLElement>('[role="option"]') || [])];
    function abreMenu() {
      if (!listaMenu || !gatilho || !candidatos.length) return;
      listaMenu.hidden = false;
      gatilho.setAttribute('aria-expanded', 'true');
      (opcoes().find((opcao) => opcao.getAttribute('aria-selected') === 'true') || opcoes()[0])?.focus();
    }
    function fechaMenu(devolveFoco = true) {
      if (!listaMenu || !gatilho || listaMenu.hidden) return;
      listaMenu.hidden = true;
      gatilho.setAttribute('aria-expanded', 'false');
      if (devolveFoco) gatilho.focus();
    }
    function escolhe(opcao: HTMLElement | null) {
      if (!opcao) return;
      fechaMenu();
      mostraGrupo(candidatos[Number(opcao.dataset.indice)] || null);
    }
    gatilho?.addEventListener('click', () => (listaMenu?.hidden ? abreMenu() : fechaMenu()));
    gatilho?.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowDown' || evento.key === 'ArrowUp') { evento.preventDefault(); abreMenu(); }
    });
    listaMenu?.addEventListener('click', (evento) => escolhe((evento.target as HTMLElement).closest<HTMLElement>('[role="option"]')));
    listaMenu?.addEventListener('keydown', (evento) => {
      const lista = opcoes();
      const posicao = lista.indexOf(document.activeElement as HTMLElement);
      if (evento.key === 'ArrowDown') { evento.preventDefault(); lista[Math.min(lista.length - 1, posicao + 1)]?.focus(); }
      else if (evento.key === 'ArrowUp') { evento.preventDefault(); lista[Math.max(0, posicao - 1)]?.focus(); }
      else if (evento.key === 'Home') { evento.preventDefault(); lista[0]?.focus(); }
      else if (evento.key === 'End') { evento.preventDefault(); lista.at(-1)?.focus(); }
      else if (evento.key === 'Enter' || evento.key === ' ') { evento.preventDefault(); escolhe(lista[posicao] || null); }
      else if (evento.key === 'Escape') { evento.preventDefault(); fechaMenu(); }
      else if (evento.key === 'Tab') fechaMenu(false);
    });
    document.addEventListener('click', (evento) => {
      if (menu && !menu.contains(evento.target as Node)) fechaMenu(false);
    });

    filtro?.addEventListener('input', filtra);
    anterior?.addEventListener('click', () => { const i = atual ? candidatos.indexOf(atual) : 0; if (i > 0) mostraGrupo(candidatos[i - 1]); });
    proximo?.addEventListener('click', () => { const i = atual ? candidatos.indexOf(atual) : -1; if (i < candidatos.length - 1) mostraGrupo(candidatos[i + 1]); });
    filtra();
    // Depois de um erro ao salvar, o formulário guarda o que foi digitado; o
    // quadro, que abre com o rascunho gravado, é refeito para acompanhar.
    if ('comErro' in form.dataset) recarrega();
  }
  document.addEventListener('astro:page-load', inicia);
</script>
