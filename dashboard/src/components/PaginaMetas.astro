---
// Corpo da página de metas e indicadores, comum às duas línguas.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';

interface Props {
  lang?: string;
}

const { lang = IDIOMA_PADRAO } = Astro.props;
const t = traduzirCom(lang, Astro.locals.interface);

// Os cinco workbooks continuam sendo o download bruto da matriz. Eram o atalho
// da topbar da rota /indicadores, que deixou de existir.
const WORKBOOKS = [1, 2, 3, 4, 5];
---

<div class="section-shell">
  {/* A rota tem duas vistas. A primeira mostra os cinco eixos, cada um com a
      jornada e a coleta dos seus indicadores; um eixo aberto mostra a lista dele
      e o painel de detalhe. Qual das duas aparece é decidido pelo endereço
      (`#eixo-3`, ou o código de um indicador) — ver metas.js. O título fica só
      para leitores de tela. */}
  <h1 class="sr-only">{t('Metas e indicadores')}</h1>

  <section class="eixos-visao card" data-eixos-visao aria-labelledby="eixos-titulo">
    <div class="eixos-topo">
      <h2 id="eixos-titulo" class="eixos-titulo">{t('Metas -')} <em>{t('Amazônia Legal.')}</em></h2>
      <div class="goals-flags" data-goals-flags role="group" aria-label={t('Estado exibido na progressão das metas')}></div>
    </div>
    <div id="eixos-cartoes" class="eixos-cartoes"></div>
  </section>

  <div class="eixo-aberto" data-eixo-aberto hidden>
    <section class="eixo-cabeca card" aria-labelledby="eixo-titulo">
      <div class="eixo-cabeca-topo">
        <button class="eixo-voltar" type="button" data-voltar-eixos>← {t('Todos os eixos')}</button>
        <nav id="eixo-abas" class="eixo-abas" aria-label={t('Eixos da Estratégia')}></nav>

        {/* Busca e download só existem com um eixo aberto, e valem para ele. A
            classe `filters-card` vem junto porque é ela que dá ao botão de
            baixar o desenho do resto do painel. */}
        <div class="goals-toolbar filters-card">
          <div class="filters-body" id="goals-filters">
            <label class="indicator-search">
              <span aria-hidden="true">⌕</span>
              <input id="indicator-search" type="search" placeholder={t('Buscar meta, indicador ou código')} autocomplete="off" />
            </label>

            {/* Seis destinos de download recolhidos num menu, ao lado da busca. */}
            <div class="export-group dropdown" id="export-menu">
              {/* A seta é a mesma do resto do painel: um `span` que o CSS desenha
                  com duas bordas giradas. */}
              <button class="dropdown-toggle export-toggle" type="button" data-export-toggle aria-expanded="false" aria-controls="export-opcoes">
                <span>{t('Baixar')}</span>
                <span class="dropdown-chevron" aria-hidden="true"></span>
              </button>
              <div class="dropdown-menu export-opcoes" id="export-opcoes" hidden>
                <button id="export-csv" class="export-primary" type="button">{t('Seleção atual em CSV')}</button>
                <p class="export-titulo">{t('Matriz completa em XLSX')}</p>
                {WORKBOOKS.map((eixo) => (
                  <a href={`/downloads/Indicadores_Resultado_Eixo${eixo}_Amazonia2050.xlsx`}>{t('Eixo')} {eixo}</a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="eixo-resumo" class="eixo-cabeca-corpo"></div>
    </section>

    <div class="goals-board">
      <section class="goals-list-card card" aria-label={t('Metas e indicadores da Estratégia')}>
        <div class="goals-list-top">
          <p class="goals-list-summary" aria-live="polite" data-lista-resumo></p>
          <div class="goals-flags" data-goals-flags role="group" aria-label={t('Estado exibido na progressão das metas')}></div>
        </div>
        <div id="goals-list" class="goals-list" role="list" aria-label={t('Metas e indicadores por eixo')}></div>
      </section>
      <aside id="goals-detail" class="goals-detail card" aria-labelledby="goals-detail-title" aria-live="polite" hidden></aside>
    </div>
  </div>
</div>
