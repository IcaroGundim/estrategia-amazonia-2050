---
// Projeções no Panorama, depois do mapa: as trajetórias pactuadas até 2050
// (conteudo/projecoes.json, que chega ao cliente dentro de /data/metas.json, em
// cada indicador), lidas por eixo. Ocupa o lugar da antiga "Trajetória", que
// projetava o ritmo dos últimos dez anos de cada meta.
//
// O bloco abre nos cinco eixos, no molde de "Cinco eixos de implementação" da
// Visão Geral: os títulos numerados à esquerda e, à direita, um painel com a
// foto e a trajetória do eixo escolhido. O eixo aberto (`#eixo-2`) mostra a
// trajetória maior e um cartão por indicador; cada cartão abre o painel lateral
// do indicador, com a série ano a ano.
//
// A trajetória de um eixo é a média do "caminho" dos indicadores dele: 0 na
// linha de base, 1 na meta final de cada um. Assim indicadores em unidades
// diferentes (%, óbitos, reais) entram na mesma conta. O cálculo e o desenho
// são do src/scripts/projecoes.js; aqui só o cabeçalho e as fotos dos eixos.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';
import { FOTOS_DOS_EIXOS } from '../lib/visao-geral';
import '../styles/projecoes.css';

interface Props { lang?: string }
const { lang = IDIOMA_PADRAO } = Astro.props;
const t = traduzirCom(lang, Astro.locals.interface);
---

<section class="pj" id="projecoes" aria-labelledby="pj-manchete" data-projecoes data-fotos={JSON.stringify(FOTOS_DOS_EIXOS)}>
  {/* Os gradientes das áreas dos gráficos, uma vez para a página: definidos
      dentro de um SVG que some (a vista dos eixos fica oculta quando um eixo
      abre), eles deixariam de pintar nos outros. */}
  <svg class="pj-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="pj-ouro" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#e0a83c" stop-opacity=".32" /><stop offset="1" stop-color="#e0a83c" stop-opacity="0" /></linearGradient>
      <linearGradient id="pj-mata" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#3e6e57" stop-opacity=".2" /><stop offset="1" stop-color="#3e6e57" stop-opacity="0" /></linearGradient>
    </defs>
  </svg>
  <div class="pj-visao" data-pj-visao>
    <div class="pj-bloco">
      <div class="pj-topo">
        <div>
          <span class="pj-sobre">{t('Projeções · 2026–2050')}</span>
          <h2 class="pj-manchete" id="pj-manchete">{t('O caminho de cada eixo até')} <em>2050.</em></h2>
        </div>
        <div class="pj-topo-dir">
          <p class="pj-lead">{t('Quanto da distância entre a linha de base e a meta final a Estratégia pactua percorrer a cada ano, na média dos indicadores de cada eixo que têm trajetória.')}</p>
          <span class="pj-escala"><b>0%</b> {t('linha de base')}<i aria-hidden="true"></i><b>100%</b> {t('meta final')}</span>
        </div>
      </div>
      <div class="pj-lado" data-pj-lado>
        <p class="pj-carregando">{t('Carregando as trajetórias…')}</p>
      </div>
      <p class="pj-fonte">{t('Trajetórias pactuadas das planilhas de projeção da Estratégia (set/2026). São metas intermediárias, não previsões nem o ritmo atual calculado no Panorama.')}</p>
    </div>
  </div>
  <div class="pj-eixo" data-pj-eixo hidden></div>
  <div class="pj-veu" data-pj-veu></div>
  <aside class="pj-gaveta" data-pj-gaveta role="dialog" aria-modal="true" aria-labelledby="pj-gaveta-titulo" hidden></aside>
</section>
