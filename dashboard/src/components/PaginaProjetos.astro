---
// Corpo da página de projetos, comum às duas línguas. A página não lista os
// projetos: explica o Brazilian Amazon Projects, o portal em que o Consórcio
// apresenta os projetos dos estados, e leva até ele. O diagrama diz o caminho
// (os nove estados → Consórcio → portal → investidores e parceiros), com a
// logo do Consórcio e uma foto da Amazônia nos dois quadros do meio. Há duas
// versões do mesmo diagrama: deitada no computador e em pé no celular, onde a
// deitada deixaria o texto miúdo. Quem anima a entrada é
// src/scripts/projetos-hub.js; sem script, tudo aparece pronto.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';
import panorama from '../../conteudo/panorama.json';

interface Props {
  lang?: string;
}

const { lang = IDIOMA_PADRAO } = Astro.props;
const t = traduzirCom(lang, Astro.locals.interface);

const PORTAL = 'https://www.brazilianamazonprojects.com';
const FOTO = '/photos/parque-nacional-do-jau.jpg';
const LOGO = '/logo-consorcio-clara.avif';
const bandeiras = Object.values(panorama.estados).map((estado) => `/flags/${encodeURIComponent(estado.flag)}`);
const rotulo = t('Os nove estados levam seus projetos ao Consórcio Interestadual da Amazônia Legal, que os publica num portal para investidores e parceiros.');

// Deitado: as bandeiras em coluna à esquerda, cada uma com um fio até o
// Consórcio; os dois quadros do meio têm o mesmo tamanho (160 × 160).
const deitado = bandeiras.map((src, i) => ({ src, i, y: 18 + i * 31 }));
// Em pé: as bandeiras numa linha no alto, descendo até o Consórcio.
const empe = bandeiras.map((src, i) => ({ src, i, x: 20 + i * 34 }));
---

<div class="section-shell">
  <section class="hub card" aria-labelledby="hub-titulo" data-hub>
    <div class="hub-topo">
      <div>
        <p class="hub-sobre hub-surge">{t('Projetos')}</p>
        <h1 id="hub-titulo" class="hub-titulo hub-surge" style="--i:1">Brazilian Amazon <em>Projects.</em></h1>
        <p class="hub-texto hub-surge" style="--i:2">{t('Os estados levam seus projetos ao Consórcio, que os publica num portal único aberto a investidores e parceiros.')}</p>
      </div>
      <a class="hub-cta hub-surge" style="--i:3" href={PORTAL} target="_blank" rel="noopener">{t('Conhecer o portal')} <span aria-hidden="true">↗</span></a>
    </div>

    <svg class="hub-fluxo is-deitado" viewBox="0 0 700 300" role="img" aria-label={rotulo}>
      <defs>
        <clipPath id="hub-recorte-deitado"><rect x="380" y="70" width="160" height="160" rx="14" /></clipPath>
        <linearGradient id="hub-sombra-deitado" x1="0" y1="0" x2="0" y2="1"><stop offset=".45" stop-color="#0e2b22" stop-opacity="0" /><stop offset="1" stop-color="#0e2b22" stop-opacity=".85" /></linearGradient>
      </defs>
      {deitado.map(({ src, i, y }) => (
        <g class="hub-estado" style={`--b:${i}`}>
          <image href={src} x="10" y={y} width="32" height="22" preserveAspectRatio="xMidYMid slice" />
          <path class="hub-fio is-fino" style={`--len:110;--d:${(0.2 + i * 0.04).toFixed(2)}s`} d={`M46 ${y + 11} C 90 ${y + 11} 90 150 120 150`} />
        </g>
      ))}
      <path class="hub-fio" style="--len:60;--d:.7s" d="M120 150 H170" />
      <g class="hub-no" style="--d:.9s">
        <rect class="hub-consorcio" x="170" y="70" width="160" height="160" rx="14" />
        <image href={LOGO} x="182" y="126" width="136" height="48" preserveAspectRatio="xMidYMid meet" />
      </g>
      <path class="hub-fio" style="--len:60;--d:1.3s" d="M330 150 H380" />
      <g class="hub-foto" style="--d:1.4s" clip-path="url(#hub-recorte-deitado)">
        <image href={FOTO} x="380" y="70" width="160" height="160" preserveAspectRatio="xMidYMid slice" />
        <rect x="380" y="70" width="160" height="160" fill="url(#hub-sombra-deitado)" />
        <text x="394" y="214">{t('Portal de projetos')}</text>
      </g>
      <path class="hub-fio" style="--len:120;--d:2.1s" d="M540 150 C 570 150 570 90 600 90" />
      <path class="hub-fio" style="--len:120;--d:2.1s" d="M540 150 C 570 150 570 210 600 210" />
      <text class="hub-no hub-publico" style="--d:2.6s" x="608" y="94">{t('Investidores')}</text>
      <text class="hub-no hub-publico" style="--d:2.7s" x="608" y="214">{t('Parceiros')}</text>
    </svg>

    <svg class="hub-fluxo is-em-pe" viewBox="0 0 340 525" role="img" aria-label={rotulo}>
      <defs>
        <clipPath id="hub-recorte-em-pe"><rect x="95" y="280" width="150" height="150" rx="14" /></clipPath>
        <linearGradient id="hub-sombra-em-pe" x1="0" y1="0" x2="0" y2="1"><stop offset=".45" stop-color="#0e2b22" stop-opacity="0" /><stop offset="1" stop-color="#0e2b22" stop-opacity=".85" /></linearGradient>
      </defs>
      {empe.map(({ src, i, x }) => (
        <g class="hub-estado" style={`--b:${i}`}>
          <image href={src} x={x} y="10" width="28" height="19" preserveAspectRatio="xMidYMid slice" />
          <path class="hub-fio is-fino" style={`--len:110;--d:${(0.2 + i * 0.04).toFixed(2)}s`} d={`M${x + 14} 32 C ${x + 14} 62 170 62 170 90`} />
        </g>
      ))}
      <g class="hub-no" style="--d:.8s">
        <rect class="hub-consorcio" x="95" y="90" width="150" height="150" rx="14" />
        <image href={LOGO} x="105" y="142" width="130" height="46" preserveAspectRatio="xMidYMid meet" />
      </g>
      <path class="hub-fio" style="--len:40;--d:1.2s" d="M170 240 V280" />
      <g class="hub-foto" style="--d:1.3s" clip-path="url(#hub-recorte-em-pe)">
        <image href={FOTO} x="95" y="280" width="150" height="150" preserveAspectRatio="xMidYMid slice" />
        <rect x="95" y="280" width="150" height="150" fill="url(#hub-sombra-em-pe)" />
        <text x="108" y="414">{t('Portal de projetos')}</text>
      </g>
      <path class="hub-fio" style="--len:120;--d:2s" d="M170 430 C 170 460 90 460 90 490" />
      <path class="hub-fio" style="--len:120;--d:2s" d="M170 430 C 170 460 250 460 250 490" />
      <text class="hub-no hub-publico" style="--d:2.5s" x="90" y="512" text-anchor="middle">{t('Investidores')}</text>
      <text class="hub-no hub-publico" style="--d:2.6s" x="250" y="512" text-anchor="middle">{t('Parceiros')}</text>
    </svg>

    <p class="hub-credito hub-surge" style="--i:6">
      {t('Foto: Ana Claudia Jatahy/MTur · Parque Nacional do Jaú, Novo Airão (AM)')} · <a href="https://www.flickr.com/photos/mturdestinos/26084876967/" target="_blank" rel="noopener">Flickr MTur Destinos</a>
    </p>
  </section>
</div>
