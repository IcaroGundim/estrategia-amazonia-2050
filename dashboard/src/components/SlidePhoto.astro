---
const { variant = 1 } = Astro.props;
const photos = [
  { file: 'solimoes.jpg', source: 'Aerial_view_of_the_Amazon_Rainforest.jpg', author: 'lubasi', license: '2.0', height: 786, place: 'Rio Solimões · Amazonas', alt: 'Vista aérea do rio Solimões entre áreas de floresta amazônica.' },
  { file: 'manaus.jpg', source: 'Amazon4.jpg', author: 'Neil Palmer / CIAT', license: '2.0', height: 850, place: 'Floresta amazônica · Amazonas', alt: 'Vista aérea da floresta e de um rio próximo a Manaus, no Amazonas.' },
  { file: 'jalapao.jpg', source: 'Jalapao_05.jpg', author: 'Pedro Henrique Álvares', license: '3.0', height: 836, place: 'Jalapão · Tocantins', alt: 'Paisagem do Parque Estadual do Jalapão, no Tocantins.' },
  { file: 'ver-o-peso.jpg', source: 'Bel%C3%A9m_Ver-o-Peso_01.jpg', author: 'Cayambe', license: '3.0', height: 828, place: 'Ver-o-Peso · Belém, Pará', alt: 'O Mercado de Ferro do Ver-o-Peso, com suas torres, e barcos de pesca atracados à frente, em Belém.' },
  { file: 'teatro-amazonas.jpg', source: 'TeatroAmazonas.jpg', author: 'Jaques Sabon', license: '3.0', height: 1000, place: 'Teatro Amazonas · Manaus', alt: 'Fachada e cúpula do Teatro Amazonas, em Manaus.' },
];
const photo = photos[variant - 1];
const source = (item: typeof photo) => `https://commons.wikimedia.org/wiki/File:${item.source}`;
const titles = ['Um território. Um futuro compartilhado.', 'Floresta em pé, qualidade de vida.', 'Conectar prioridades. Valorizar o território.', 'Cooperação que atravessa fronteiras.', 'Evidências para orientar o futuro.'];
---
<figure class="slide-photo">
  {/* `display: contents` por padrão: o invólucro só existe como caixa na lâmina
      emoldurada, onde precisa centrar a foto e dar a ela um box do tamanho exato
      da imagem. Nas demais, some do layout e a foto segue posicionada como antes. */}
  <div class="slide-photo-well">
    <img class="slide-photo-main" src={`/photos/${photo.file}`} alt={photo.alt} width={variant === 5 ? 683 : 1280} height={photo.height} loading={variant === 1 ? 'eager' : 'lazy'} />
  </div>
  <div class="slide-photo-caption"><span>{photo.place}</span><p>{titles[variant - 1]}</p></div>
  <figcaption>
    <a href={source(photo)} target="_blank" rel="noreferrer">{photo.author} · Wikimedia Commons ↗</a>
    <span><a href={`https://creativecommons.org/licenses/by-sa/${photo.license}/`} target="_blank" rel="noreferrer">CC BY-SA {photo.license}</a> · recorte de exibição</span>
  </figcaption>
</figure>
