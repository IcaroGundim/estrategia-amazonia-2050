---
// Corpo da Visão Geral — as cinco lâminas sobre a Estratégia —, comum às duas
// línguas. Os textos vêm de conteudo/textos.json (visaoGeral), editáveis sem
// tocar no código; cada um é um par { pt, en }, e o inglês que faltar aparece
// em português. Só a moldura (botões, navegação, rótulos de interface) continua
// no dicionário.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';
import SlidePhoto from './SlidePhoto.astro';
import textosPublicados from '../../conteudo/textos.json';

interface Props {
  lang?: string;
  /** Outra versão dos textos, no mesmo formato do JSON: a prévia da administração passa o rascunho por aqui. */
  textos?: typeof textosPublicados;
}

const { lang = IDIOMA_PADRAO, textos = textosPublicados } = Astro.props;
const t = traduzirCom(lang, Astro.locals.interface);
const tx = (par: { pt: string; en?: string | null } | string) =>
  (typeof par === 'string' ? par : (lang === 'en' && par.en) ? par.en : par.pt);

const { estrategia, visao2050, eixos, governanca, estePainel } = textos.visaoGeral;
// O rascunho da administração pode ainda não ter o crédito, se a mescla com a
// main falhou; aí vale o publicado.
const contribuicao = estePainel.contribuicao ?? textosPublicados.visaoGeral.estePainel.contribuicao;
// Idem para a citação dos governadores sobre o IPAM.
const citacao = estePainel.citacao ?? textosPublicados.visaoGeral.estePainel.citacao;
// Idem para a governança, que trocou de forma (instâncias no lugar de blocos e fluxo).
const gov = 'instancias' in governanca ? governanca : textosPublicados.visaoGeral.governanca;
// Cada degrau da escada é uma instância principal e, ao lado, a de apoio ligada a ela (ou nada).
type Instancia = (typeof gov.instancias)[number];
const degraus: (Instancia | undefined)[][] = gov.instancias
  .filter((instancia) => !('aoLadoDe' in instancia))
  .map((principal) => [principal, gov.instancias.find((instancia) => 'aoLadoDe' in instancia && instancia.aoLadoDe === principal.id)]);

const INDICE = [
  { href: '#a-estrategia', rotulo: 'Estratégia' },
  { href: '#visao-2050', rotulo: 'Visão 2050' },
  { href: '#eixos-de-implementacao', rotulo: 'Eixos' },
  { href: '#governanca', rotulo: 'Governança' },
  { href: '#calculo', rotulo: 'IPAM' }
];

const rotaMetas = lang === 'en' ? '/en/goals' : '/metas';
---

<div class="methodology-layout section-shell">
<div class="overview-palco">
  <div class="overview-deck" role="region" aria-roledescription={t('carrossel')} aria-label={t('Visão Geral da Estratégia Amazônia 2050')}>
    <article class="methodology-article" tabindex="0" aria-label={t('Slides; use as setas para navegar')}>
      <section id="a-estrategia" class="methodology-intro method-section">
        <div class="slide-copy">
          {/* Título e abertura andam juntos: no tablet eles ocupam um quadrante do
              card ao lado da capa (ver overview-compositions.css). */}
          <div class="slide-abertura">
            <h1><span>{tx(estrategia.tituloLinha1)}</span><em>{tx(estrategia.tituloLinha2)}</em></h1>
            <a class="method-pdf-link" href={estrategia.botaoPdf.href} target="_blank" rel="noopener">
              <strong>{tx(estrategia.botaoPdf.rotulo)} ↗</strong>
            </a>
            <p class="methodology-lead">{tx(estrategia.abertura)}</p>
          </div>

          <div class="method-facts">
            {estrategia.numeros.map(({ valor, rotulo }) => (
              <div><strong>{valor}</strong><span>{tx(rotulo)}</span></div>
            ))}
            <p>{tx(estrategia.fechamento)}</p>
          </div>
        </div>
        <SlidePhoto variant={1} lang={lang} />
      </section>

      <section id="visao-2050" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(visao2050.chapeu)}</p>
          <h2>{tx(visao2050.titulo)}</h2>

          <div class="method-vision">
            <span>{tx(visao2050.selo)}</span>
            {visao2050.paragrafos.map((paragrafo) => <p>{tx(paragrafo)}</p>)}
          </div>

          <div class="method-subsection is-single">
            <div>
              <p class="eyebrow">{tx(visao2050.subChapeu)}</p>
              <h3>{tx(visao2050.subTitulo)}</h3>
            </div>
          </div>
          <ul class="method-list is-duas">
            {visao2050.lista.map((item) => <li>{tx(item)}</li>)}
          </ul>
        </div>
        <SlidePhoto variant={2} lang={lang} />
      </section>

      <section id="eixos-de-implementacao" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(eixos.chapeu)}</p>
          <h2>{tx(eixos.titulo)}</h2>
          <p>{tx(eixos.abertura)}</p>
          <div class="method-steps is-eixos">
            {eixos.itens.map(({ numero, titulo, texto }) => (
              <article>
                <b>{numero}</b>
                <h3>{tx(titulo)}</h3>
                <p>{tx(texto)}</p>
              </article>
            ))}
          </div>
        </div>
        <SlidePhoto variant={3} lang={lang} />
      </section>

      {/* Quem decide: a escada das instâncias, de baixo (estados) para cima
          (governadores), e o detalhe da instância escolhida ao lado. Os sete
          detalhes já vêm no HTML e o clique só alterna qual aparece (metodologia.js). */}
      <section id="governanca" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(gov.chapeu)}</p>
          <h2>{tx(gov.titulo)}</h2>
          <p>{tx(gov.abertura)}</p>

          <div class="gov-estrutura">
            <div class="gov-diagrama">
              <div class="gov-trilha" aria-hidden="true"><span>{tx(gov.trilha)}</span></div>
              <div class="gov-escada">
                {degraus.map((degrau) => (
                  <div class="gov-degrau">
                    {degrau.map((instancia) => instancia ? (
                      <button type="button" class={`gov-instancia is-${instancia.tipo}`} data-instancia={instancia.id} aria-controls={`gov-detalhe-${instancia.id}`} aria-pressed={String(instancia.id === gov.instancias[0].id)}>
                        <span class="gov-etiqueta">{tx(instancia.etiqueta)}</span>
                        <span class="gov-nome">{tx(instancia.nome)}</span>
                        <span class="gov-frequencia">{tx(instancia.frequencia)}</span>
                        {instancia.selo && <span class="gov-selo">{tx(instancia.selo)}</span>}
                      </button>
                    ) : <span class="gov-vazio" />)}
                  </div>
                ))}
              </div>
            </div>
            <p class="gov-legenda">
              {gov.legenda.map(({ tipo, texto }) => <span><i class={`is-${tipo}`} />{tx(texto)}</span>)}
            </p>

            <aside class="gov-painel" aria-live="polite">
              {gov.instancias.map((instancia, indice) => (
                <div class="gov-detalhe" id={`gov-detalhe-${instancia.id}`} data-detalhe={instancia.id} hidden={indice !== 0}>
                  <p class="gov-natureza">{tx(instancia.natureza)}</p>
                  <h3>{tx(instancia.nome)}</h3>
                  <dl>
                    <div><dt>{tx(gov.rotulos.reune)}</dt><dd>{tx(instancia.frequencia)}</dd></div>
                    <div><dt>{tx(gov.rotulos.quem)}</dt><dd>{tx(instancia.quem)}</dd></div>
                    <div><dt>{tx(gov.rotulos.papel)}</dt><dd>{tx(instancia.papel)}</dd></div>
                    {instancia.limites && <div class="is-limite"><dt>{tx(gov.rotulos.limites)}</dt><dd>{tx(instancia.limites)}</dd></div>}
                  </dl>
                </div>
              ))}
            </aside>
          </div>
        </div>
      </section>

      <section id="calculo" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(estePainel.chapeu)}</p>
          <h2>{tx(estePainel.titulo)}</h2>
          <p>{tx(estePainel.abertura)}</p>

          <div class="method-guidance-grid">
            {estePainel.itens.map(({ titulo, texto }) => (
              <article><h3>{tx(titulo)}</h3><p>{tx(texto)}</p></article>
            ))}
          </div>

          <figure class="method-source-block is-citacao">
            <span>{tx(citacao.rotulo)}</span>
            <blockquote><p>{tx(citacao.texto)}</p></blockquote>
            <figcaption>{tx(citacao.autor)}</figcaption>
          </figure>

          <div class="method-actions">
            <a class="primary-link" href={rotaMetas}>{t('Ver o cumprimento das metas')}</a>
            <a class="secondary-link" href={rotaMetas}>{t('Explorar metas e indicadores')}</a>
          </div>
        </div>
        {/* No lugar da fotografia, o crédito ao IPAM, dentro da mesma moldura. A marca
            é a versão vertical colorida, a preferencial do manual do instituto, e
            vai sem efeito nenhum sobre ela. */}
        <aside class="slide-contribuicao" aria-label={tx(contribuicao.rotulo)}>
          <span>{tx(contribuicao.rotulo)}</span>
          <img src="/logo-ipam-amazonia.png" alt="IPAM Amazônia" width="720" height="844" loading="lazy" />
          <a href="https://ipam.org.br" target="_blank" rel="noreferrer">ipam.org.br ↗</a>
        </aside>
      </section>
    </article>

    <div class="overview-controls">
      <span class="overview-status" aria-live="polite" aria-atomic="true"><b data-slide-count>01 / 05</b><span data-slide-title>{t('Estratégia')}</span></span>
      <aside class="methodology-index" aria-label={t('Navegação dos slides')}>
        <nav>
          {INDICE.map(({ href, rotulo }, indice) => (
            <a class={indice === 0 ? 'is-active' : undefined} href={href}>
              <span><strong>{t(rotulo)}</strong></span>
            </a>
          ))}
        </nav>
      </aside>
    </div>
  </div>
  {/* Fora do cartão de propósito: as abas laterais se posicionam pelo palco, não pela barra
      de controles (ver overview-compositions.css). */}
  <div class="overview-buttons"><button type="button" data-slide-prev aria-label={t('Slide anterior')}>← <span>{t('Anterior')}</span></button><button type="button" data-slide-next aria-label={t('Próximo slide')}><span>{t('Próximo')}</span> →</button></div>
</div>
</div>
