---
// Corpo da Visão Geral — as cinco lâminas sobre a Estratégia —, comum às duas
// línguas.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';
import SlidePhoto from './SlidePhoto.astro';

interface Props {
  lang?: string;
}

const { lang = IDIOMA_PADRAO } = Astro.props;
const t = traduzirCom(lang);

const TEMAS = [
  {
    numero: '01',
    titulo: 'Integração regional',
    texto: 'Ordenamento territorial, segurança fundiária, conectividade física e digital e cooperação interestadual e transfronteiriça.'
  },
  {
    numero: '02',
    titulo: 'Sistemas produtivos sustentáveis',
    texto: 'Uma economia de baixo carbono, inovadora e centrada na sociobiodiversidade, gerando valor e renda a partir da floresta em pé.'
  },
  {
    numero: '03',
    titulo: 'Soluções baseadas na natureza',
    texto: 'Valorização econômica dos ativos ambientais, com conservação, restauração e uso sustentável dos ecossistemas.'
  },
  {
    numero: '04',
    titulo: 'Transição energética',
    texto: 'A Amazônia como polo de inovação em energia limpa, ampliando o acesso à energia renovável.'
  },
  {
    numero: '05',
    titulo: 'Inclusão social e resiliência',
    texto: 'Redução de desigualdades, acesso a serviços essenciais e resiliência das populações frente às mudanças climáticas.'
  },
  {
    numero: '06',
    titulo: 'Infraestrutura sustentável',
    texto: 'Infraestrutura física, logística e digital integrada e resiliente, respeitando os limites socioambientais.'
  }
];

const GOVERNANCA = [
  { titulo: 'Priorização e aderência', texto: 'Consolidar e validar as prioridades estaduais, com aderência à realidade de cada território.' },
  { titulo: 'Qualificação de projetos', texto: 'Mapear os projetos prioritários, identificando maturidade, gargalos e oportunidades.' },
  { titulo: 'Compatibilização institucional', texto: 'Integrar a Estratégia aos PPAs, LDOs, LOAs e planos setoriais.' },
  { titulo: 'Articulação transversal', texto: 'Articular secretarias finalísticas e áreas técnicas entre as agendas.' },
  { titulo: 'Interdependência regional', texto: 'Incorporar a lógica regional ao planejamento estadual.' },
  { titulo: 'Monitoramento e avaliação', texto: 'Acompanhar a Estratégia e manter indicadores e metas atualizados.' }
];

const FLUXO = [
  'Definição de prioridades regionais',
  'Compatibilização com os PPAs estaduais',
  'Desdobramento em LDO, LOA e planos setoriais',
  'Monitoramento e avaliação regional'
];

const INDICE = [
  { href: '#a-estrategia', rotulo: 'A Estratégia' },
  { href: '#visao-2050', rotulo: 'Visão 2050' },
  { href: '#temas-estrategicos', rotulo: 'Temas estratégicos' },
  { href: '#governanca', rotulo: 'Governança' },
  { href: '#calculo', rotulo: 'Este painel' }
];

const rotaMetas = lang === 'en' ? '/en/goals' : '/metas';
---

<div class="methodology-layout section-shell">
  <div class="overview-deck" role="region" aria-roledescription={t('carrossel')} aria-label={t('Visão Geral da Estratégia Amazônia 2050')}>
    <article class="methodology-article" tabindex="0" aria-label={t('Slides; use as setas para navegar')}>
      <section id="a-estrategia" class="methodology-intro method-section">
        <div class="slide-copy">
          <p class="eyebrow">{t('Consórcio da Amazônia Legal · Brasília, 2026')}</p>
          <h1><span>{t('A Estratégia Regional')}</span><em>{t('Amazônia 2050')}</em></h1>
          <p class="methodology-lead">{t('Um instrumento de planejamento regional de longo prazo, que estabelece uma visão compartilhada de desenvolvimento sustentável para os nove estados da Amazônia Legal até 2050. É distinta do Planejamento Estratégico do Consórcio, que organiza a atuação institucional da autarquia.')}</p>

          <div class="method-facts">
            <div><strong>09</strong><span>{t('estados consorciados')}</span></div>
            <div><strong>06</strong><span>{t('temas estratégicos')}</span></div>
            <div><strong>2050</strong><span>{t('horizonte pactuado')}</span></div>
            <p>{t('Construída ao longo de 2025 em processo participativo, a partir da solicitação do Ministério do Planejamento e Orçamento para a Estratégia Brasil 2050. Teve Grupo de Trabalho com os nove estados, oficina presencial em Belém e apoio técnico do IPAM. Foi apresentada na COP30 como uma das principais entregas do Consórcio.')}</p>
          </div>

          <div class="method-timeline">
            <article><b>2019</b><span>{t('Primeiro Planejamento do Consórcio, com as diretrizes regionais essenciais.')}</span></article>
            <article><b>2023</b><span>{t('Revisão do instrumento, consolidando aprendizados e novas prioridades.')}</span></article>
            <article><b>2024–2035</b><span>{t('Planejamento Estratégico, que orienta a atuação institucional.')}</span></article>
            <article><b>2025</b><span>{t('Estratégia Amazônia 2050, o horizonte regional de longo prazo.')}</span></article>
          </div>
        </div>
        <SlidePhoto variant={1} lang={lang} />
      </section>

      <section id="visao-2050" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{t('O horizonte')}</p>
          <h2>{t('A visão regional para 2050')}</h2>

          <div class="method-vision">
            <span>{t('Visão 2050')}</span>
            <p>{t('Em 2050, a Amazônia Legal terá alcançado o desenvolvimento regional sustentável e a resiliência climática, conciliando conservação ambiental, crescimento econômico e justiça social. A região será reconhecida pelo equilíbrio entre produção e conservação, pela valorização de seus ativos ambientais e pela melhoria dos indicadores socioeconômicos.')}</p>
            <p>{t('Os saberes e modos de vida dos povos e comunidades tradicionais serão preservados, assegurando qualidade de vida, inclusão e contribuição efetiva para a estabilidade climática global.')}</p>
          </div>

          <div class="method-subsection is-single">
            <div>
              <p class="eyebrow">{t('Na prática')}</p>
              <h3>{t('Como a Estratégia auxilia os estados')}</h3>
            </div>
          </div>
          <ul class="method-list is-duas">
            <li>{t('Alinha a visão de longo prazo ao planejamento governamental de médio prazo.')}</li>
            <li>{t('Subsidia a revisão e a formulação de PPAs, LDOs e planos setoriais.')}</li>
            <li>{t('Dá coerência entre as prioridades estaduais e a agenda regional.')}</li>
            <li>{t('Fortalece a articulação com a União, organismos multilaterais e financiadores.')}</li>
            <li>{t('Qualifica a priorização de investimentos estruturantes.')}</li>
          </ul>
        </div>
        <SlidePhoto variant={2} lang={lang} />
      </section>

      <section id="temas-estrategicos" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{t('Estrutura da Estratégia')}</p>
          <h2>{t('Seis temas estratégicos')}</h2>
          <p>{t('Os temas organizam as prioridades regionais e servem de referência para a leitura dos indicadores deste painel.')}</p>
          <div class="method-steps is-themes">
            {TEMAS.map(({ numero, titulo, texto }) => (
              <article>
                <b>{numero}</b>
                <h3>{t(titulo)}</h3>
                <p>{t(texto)}</p>
              </article>
            ))}
          </div>
        </div>
        <SlidePhoto variant={3} lang={lang} />
      </section>

      <section id="governanca" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{t('Implementação')}</p>
          <h2>{t('Governança e próximos passos')}</h2>
          <div class="method-guidance-grid is-compacta">
            {GOVERNANCA.map(({ titulo, texto }) => (
              <article><h3>{t(titulo)}</h3><p>{t(texto)}</p></article>
            ))}
          </div>

          <ol class="method-flow">
            {FLUXO.map((etapa, indice) => (
              <li><b>{String(indice + 1).padStart(2, '0')}</b><span>{t(etapa)}</span></li>
            ))}
          </ol>
        </div>
        <SlidePhoto variant={4} lang={lang} />
      </section>

      <section id="calculo" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{t('Este painel')}</p>
          <h2>{t('Como os dados são lidos aqui')}</h2>
          <p>{t('O painel organiza indicadores de fontes públicas para comparar os nove estados. Ele antecipa uma leitura enquanto a metodologia de monitoramento da Estratégia não é definida.')}</p>

          <div class="method-guidance-grid">
            <article><h3>{t('Períodos diferentes')}</h3><p>{t('Cada base entra com seu período mais recente, então os anos de referência não são uniformes entre indicadores.')}</p></article>
          </div>

          <div class="method-source-block">
            <span>{t('Fontes consolidadas')}</span>
            <p data-method-sources>{t('Carregando fontes…')}</p>
          </div>

          <div class="method-actions">
            <a class="primary-link" href={rotaMetas}>{t('Ver o cumprimento das metas')}</a>
            <a class="secondary-link" href={rotaMetas}>{t('Explorar metas e indicadores')}</a>
          </div>
        </div>
        <SlidePhoto variant={5} lang={lang} />
      </section>
    </article>

    <div class="overview-controls">
      <span class="overview-status" aria-live="polite" aria-atomic="true"><b data-slide-count>01 / 05</b><span data-slide-title>{t('A Estratégia')}</span></span>
      <aside class="methodology-index" aria-label={t('Navegação dos slides')}>
        <nav>
          {INDICE.map(({ href, rotulo }, indice) => (
            <a class={indice === 0 ? 'is-active' : undefined} href={href}>
              <span><strong>{t(rotulo)}</strong></span>
            </a>
          ))}
        </nav>
      </aside>
      <div class="overview-buttons"><button type="button" data-slide-prev aria-label={t('Slide anterior')}>← <span>{t('Anterior')}</span></button><button type="button" data-slide-next aria-label={t('Próximo slide')}><span>{t('Próximo')}</span> →</button></div>
    </div>
  </div>
</div>
