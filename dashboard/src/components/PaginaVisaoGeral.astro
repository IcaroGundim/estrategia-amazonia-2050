---
// Corpo da Visão Geral — as cinco lâminas sobre a Estratégia —, comum às duas
// línguas. Os textos vêm de conteudo/textos.json (visaoGeral), editáveis sem
// tocar no código; cada um é um par { pt, en }, e o inglês que faltar aparece
// em português. Só a moldura (botões, navegação, rótulos de interface) continua
// no dicionário.
import { IDIOMA_PADRAO, traduzirCom } from '../i18n/index.js';
import SlidePhoto from './SlidePhoto.astro';
import textosPublicados from '../../conteudo/textos.json';

interface Props {
  lang?: string;
  /** Outra versão dos textos, no mesmo formato do JSON: a prévia da administração passa o rascunho por aqui. */
  textos?: typeof textosPublicados;
}

const { lang = IDIOMA_PADRAO, textos = textosPublicados } = Astro.props;
const t = traduzirCom(lang, Astro.locals.interface);
const tx = (par: { pt: string; en?: string | null } | string) =>
  (typeof par === 'string' ? par : (lang === 'en' && par.en) ? par.en : par.pt);

const { estrategia, visao2050, temas, governanca, estePainel } = textos.visaoGeral;

const INDICE = [
  { href: '#a-estrategia', rotulo: 'A Estratégia' },
  { href: '#visao-2050', rotulo: 'Visão 2050' },
  { href: '#temas-estrategicos', rotulo: 'Temas estratégicos' },
  { href: '#governanca', rotulo: 'Governança' },
  { href: '#calculo', rotulo: 'Este painel' }
];

const rotaMetas = lang === 'en' ? '/en/goals' : '/metas';
---

<div class="methodology-layout section-shell">
  <div class="overview-deck" role="region" aria-roledescription={t('carrossel')} aria-label={t('Visão Geral da Estratégia Amazônia 2050')}>
    <article class="methodology-article" tabindex="0" aria-label={t('Slides; use as setas para navegar')}>
      <section id="a-estrategia" class="methodology-intro method-section">
        <div class="slide-copy">
          <a class="method-pdf-link" href={estrategia.botaoPdf.href} target="_blank" rel="noopener">
            <strong>{tx(estrategia.botaoPdf.rotulo)} ↗</strong>
          </a>
          <h1><span>{tx(estrategia.tituloLinha1)}</span><em>{tx(estrategia.tituloLinha2)}</em></h1>
          <p class="methodology-lead">{tx(estrategia.abertura)}</p>

          <div class="method-facts">
            {estrategia.numeros.map(({ valor, rotulo }) => (
              <div><strong>{valor}</strong><span>{tx(rotulo)}</span></div>
            ))}
            <p>{tx(estrategia.fechamento)}</p>
          </div>
        </div>
        <SlidePhoto variant={1} lang={lang} />
      </section>

      <section id="visao-2050" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(visao2050.chapeu)}</p>
          <h2>{tx(visao2050.titulo)}</h2>

          <div class="method-vision">
            <span>{tx(visao2050.selo)}</span>
            {visao2050.paragrafos.map((paragrafo) => <p>{tx(paragrafo)}</p>)}
          </div>

          <div class="method-subsection is-single">
            <div>
              <p class="eyebrow">{tx(visao2050.subChapeu)}</p>
              <h3>{tx(visao2050.subTitulo)}</h3>
            </div>
          </div>
          <ul class="method-list is-duas">
            {visao2050.lista.map((item) => <li>{tx(item)}</li>)}
          </ul>
        </div>
        <SlidePhoto variant={2} lang={lang} />
      </section>

      <section id="temas-estrategicos" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(temas.chapeu)}</p>
          <h2>{tx(temas.titulo)}</h2>
          <p>{tx(temas.abertura)}</p>
          <div class="method-steps is-themes">
            {temas.itens.map(({ numero, titulo, texto }) => (
              <article>
                <b>{numero}</b>
                <h3>{tx(titulo)}</h3>
                <p>{tx(texto)}</p>
              </article>
            ))}
          </div>
        </div>
        <SlidePhoto variant={3} lang={lang} />
      </section>

      <section id="governanca" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(governanca.chapeu)}</p>
          <h2>{tx(governanca.titulo)}</h2>
          <div class="method-guidance-grid is-compacta">
            {governanca.itens.map(({ titulo, texto }) => (
              <article><h3>{tx(titulo)}</h3><p>{tx(texto)}</p></article>
            ))}
          </div>

          <ol class="method-flow">
            {governanca.fluxo.map((etapa, indice) => (
              <li><b>{String(indice + 1).padStart(2, '0')}</b><span>{tx(etapa)}</span></li>
            ))}
          </ol>
        </div>
        <SlidePhoto variant={4} lang={lang} />
      </section>

      <section id="calculo" class="method-section">
        <div class="slide-copy">
          <p class="eyebrow">{tx(estePainel.chapeu)}</p>
          <h2>{tx(estePainel.titulo)}</h2>
          <p>{tx(estePainel.abertura)}</p>

          <div class="method-guidance-grid">
            {estePainel.itens.map(({ titulo, texto }) => (
              <article><h3>{tx(titulo)}</h3><p>{tx(texto)}</p></article>
            ))}
          </div>

          <div class="method-source-block">
            <span>{tx(estePainel.fontesRotulo)}</span>
            <p data-method-sources>{t('Carregando fontes…')}</p>
          </div>

          <div class="method-actions">
            <a class="primary-link" href={rotaMetas}>{t('Ver o cumprimento das metas')}</a>
            <a class="secondary-link" href={rotaMetas}>{t('Explorar metas e indicadores')}</a>
          </div>
        </div>
        <SlidePhoto variant={5} lang={lang} />
      </section>
    </article>

    <div class="overview-controls">
      <span class="overview-status" aria-live="polite" aria-atomic="true"><b data-slide-count>01 / 05</b><span data-slide-title>{t('A Estratégia')}</span></span>
      <aside class="methodology-index" aria-label={t('Navegação dos slides')}>
        <nav>
          {INDICE.map(({ href, rotulo }, indice) => (
            <a class={indice === 0 ? 'is-active' : undefined} href={href}>
              <span><strong>{t(rotulo)}</strong></span>
            </a>
          ))}
        </nav>
      </aside>
      <div class="overview-buttons"><button type="button" data-slide-prev aria-label={t('Slide anterior')}>← <span>{t('Anterior')}</span></button><button type="button" data-slide-next aria-label={t('Próximo slide')}><span>{t('Próximo')}</span> →</button></div>
    </div>
  </div>
</div>
