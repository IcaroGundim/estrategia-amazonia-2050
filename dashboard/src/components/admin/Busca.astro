---
// Busca instantânea nas listas longas: filtra os itens das listas (`.admin-lista li`)
// ou dos cards (`.admin-cards > *`) pelo texto e esconde as seções que ficarem
// vazias. Com `filtros`, um seletor ao lado restringe aos itens cujo
// `data-estado` bate com a opção escolhida (a opção de valor vazio é "todos").
interface Props {
  placeholder?: string;
  filtros?: { valor: string; rotulo: string }[];
}
const { placeholder = 'Buscar por código ou nome', filtros = [] } = Astro.props;
---

<div class="admin-busca" data-busca>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
  <input type="search" placeholder={placeholder} autocomplete="off" aria-label="Buscar na lista" />
  <small data-busca-resumo></small>
</div>
{filtros.length > 0 && (
  <span class="admin-seletor" role="group" aria-label="Filtrar" data-busca-filtros>
    {filtros.map((filtro, indice) => (
      <button type="button" class={indice === 0 ? 'is-ativo' : undefined} aria-pressed={indice === 0 ? 'true' : 'false'} data-filtro={filtro.valor}>{filtro.rotulo}</button>
    ))}
  </span>
)}

<script>
  function inicia() {

    const semAcento = (texto: string) => texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    document.querySelectorAll<HTMLElement>('[data-busca]').forEach((caixa) => {
      const entrada = caixa.querySelector('input')!;
      const resumo = caixa.querySelector<HTMLElement>('[data-busca-resumo]')!;
      const filtros = caixa.nextElementSibling?.matches('[data-busca-filtros]') ? [...caixa.nextElementSibling.querySelectorAll<HTMLButtonElement>('[data-filtro]')] : [];
      const secoes = [...document.querySelectorAll<HTMLElement>('.admin-cartao, .admin-eixo')].filter((secao) => secao.querySelector('.admin-lista, .admin-cards'));
      const itens = secoes.flatMap((secao) => [...secao.querySelectorAll<HTMLElement>('.admin-lista li, .admin-cards > *')]);
      let estado = '';
      const filtra = () => {
        const termo = semAcento(entrada.value.trim());
        let visiveis = 0;
        for (const item of itens) {
          const bate = (!termo || semAcento(item.textContent || '').includes(termo)) && (!estado || item.dataset.estado === estado);
          item.hidden = !bate;
          if (bate) visiveis += 1;
        }
        for (const secao of secoes) secao.classList.toggle('is-vazio-na-busca', Boolean(termo || estado) && ![...secao.querySelectorAll<HTMLElement>('.admin-lista li, .admin-cards > *')].some((item) => !item.hidden));
        resumo.textContent = termo || estado ? `${visiveis} de ${itens.length}` : '';
      };
      entrada.addEventListener('input', filtra);
      filtros.forEach((botao) => botao.addEventListener('click', () => {
        estado = botao.dataset.filtro || '';
        filtros.forEach((outro) => {
          const ativo = outro === botao;
          outro.classList.toggle('is-ativo', ativo);
          outro.setAttribute('aria-pressed', String(ativo));
        });
        filtra();
      }));
    });
  }
  document.addEventListener('astro:page-load', inicia);
</script>
