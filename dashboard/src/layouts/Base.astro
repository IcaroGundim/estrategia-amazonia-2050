                  </mask>
                </defs>
                <path class="brand-rio" d="m241.7 101.7c-9-2.8-11.8-7.9-13.6-13.1-1.2-3.6-1.8-7.2-5.5-7.3-1.6 0.1-3.2 1-4.4 3.6s-1.3 3.7-2.2 6.6c-1.7 5-3.2 8.4-5.1 9.8-1.9 0.9-3.1-2-3.3-4.3-0.1-2.1 1.2-5.6 0-6.9-0.5-0.6-1.6-0.8-0.9-1.9 0.6-0.8 1.7-1.6 1.1-3-0.7-1.4-3.2-1.6-3.3 1.8-0.1 2.5 0.4 7-2.5 12.7-0.7 1.2-1.3 2.2-2.9 2-1.9-0.4-2.6-2.7-2.4-5.4 0.5-4.9 1.9-8 1.6-11-0.3-2.8-2.9-4.2-4.9-4.2-1.6 0-3.1 0.7-4 2.2-2 3.1-3.3 8-5.6 10.4-1.3 1.2-1.8 0-1.4-1.1 1-2.2 4-5.9 4.4-7.7 0.7-3.3-2.4-4.3-4.7-3.6-2.7 0.8-3.7 3.2-5.3 3.6-1.1 0.1-3-4.9-6.3-5.6-2.3-0.4-4.2 2.1-5.9 5.9-1.9 3.7-4.3 4.6-5.7 8.2-1.6 4.6-0.7 15.6-8.1 19.7-3.1 1.8-8.8 2.5-12.3 0.8-4.7-2.5-2-7.1 1.1-10.1 6.4-6 15.3-9.7 17.9-15.7 0.4-1 0.5-1.7 0.5-2.8 0-3-3-4.8-9.4-3.8-7.6 1.1-6.3 6.4-7.2 9.7-1.5 4.6-5.1 2.7-6.9-0.2-1.9-2.8-3.2-5.8-6.4-5.6-1.3 0.2-2.8 0.8-3.7 3.2-0.8 2.3-1.3 5.1-3.2 10.5-1.3 3.8-2.5 7.3-4.7 6.8-3.7-1.2-0.8-8.6-0.6-15.4 0.1-2.6-1.3-6.3-5.8-6.2-4.7 0-6.3 3.7-5.9 8 0.2 4 1.7 7.7 0.1 10.6-1.2 1.8-4.1 1.8-3.9-2.6 0.1-2.7 1.2-6.4 1-8.5-0.3-1.8-1.8-3.9-4.9-3.9-2.9 0-5.1 1.6-5.2 5.5l0.1 4.9c0.1 5.2-3.5 5.3-4.5 2.1-0.8-2.8-1.3-8.2-2.7-12.6-1.2-3.8-2.8-5.4-5.5-5.4-2.9 0.2-4.3 2.6-5.7 5.5-3.8 8.2-6.3 14.3-15 17.5-0.8 0.3-1.3 0.7-1.3 1.2 0 2.5 3.5 2.3 6.4 0.1 4-2.9 6.1-6.8 9.5-9 2.7-2 7.3-3 10.3 0.3 1.7 2 2.5 5.6 4 7.4 0.7 0.6 1.2 0.9 2.3 0.8 3.1-0.1 4.8-3.1 4.7-5.9 0.1-3-0.8-7.7 0.5-9.4 1.3-1.8 5.1-2 4.8 2.1-0.5 3.1-1.4 6.6-1.5 8.4-0.1 3.5 1.8 5.5 4.7 5.4 4.3-0.1 6.2-4.1 5.2-7.9-0.7-2.7-2.4-6.8-1.2-9.5 1.4-2.9 6.7-3.7 6.4 1.5-0.4 4.8-3.1 17.3 2.9 17.7 2.9 0.1 4.4-1.6 7.2-5.7 2-2.6 9.1-7.4 12.9-6.9 1.1 0.2 1.8 0.7 2.8 0.6 3.6-0.2 4.5-6.9 5.2-8.9 1-2.4 3.5-3.6 8.1-3.7 1.5 0 3.3 0.1 3.5 1.8 0.2 3.7-7.9 7.8-16.9 15.5-2.6 2.3-6.8 6.5-6.5 11 0.7 6 10.1 7.8 17.9 4.3 2.7-1.3 5-3.1 6.9-6.8 4.3-7.1 2.6-16.9 5.3-18.5 0.6-0.4 1.3-0.2 1.4 0.7 0.6 2.9 1.7 7.1 6.1 7.1 2.2-0.1 3.9-1.2 5.3-3.8 1.8-3.4 1.2-9.6 4.6-11.7 2.1-1 4.6 0 4 2.6-0.9 3.6-5.7 6.2-5.2 8.9 0.2 1.5 3.1 3 5.2 1.3 2.9-2.5 3.4-8.3 6-11.1 1.9-2.3 5.4-1.3 5.3 2.5 0 3.8-2.2 10.3-1 13.8 0.5 1.3 1.4 2.5 3.9 2.5 4-0.3 5.4-3.1 6.6-7.4h0.3c0.4 3.6 1.4 6.8 4.2 6.8 4.2 0 4.9-5.7 6.9-7.1 1.9-1.7 5.7 0.2 8.9-0.9l2.5-1.3c4.3 6.4 11.6 9.9 15.3 9.9 1 0.1 1.9-1.9 0.1-2.5h-0.8zm-169.5-7.4c1.2-3.3 3.1-9.7 5.8-9.8 2.9-0.1 4.6 8.7 5.3 11.9-2.9-2.2-6.1-3.8-10.9-2.2l-0.2 0.1zm52.3 4.5v-0.2c0.5-1.6 1.8-5 2.2-7.6 1.3-5.1 4.6-2.6 8 2.9-5 0-7.4 3.2-10.1 4.8l-0.1 0.1zm48-4.4c-1.8 4.7-7.1 1.9-7.5-3.1 0-2 4.6-6 7-6.3 2.3-0.1 2.3 3 1.5 7.2l-1 2.2zm-6.8-7.9-0.3-0.1c1.1-2.7 4.7-7.5 8-2.8-2.7-1-4.8-0.2-7.7 3v-0.1zm50.9 7 1.8-6.2c1-1.7 2.5-3.4 4.6-2.3 0.9 0.6 2.5 4.8 2.8 6-1.9 4.1-6.4 2.3-9.1 2.7z" />
              </svg></strong>
            </span>
            <b class="brand-product-ano">2050</b>
          </span>
        </a>

        <nav class="topnav" aria-label={t('Navegação principal')}>
          {NAVEGACAO.map(({ chave, rotulo }) => (
            <a
              href={rota(chave, lang)}
              class={chave === pagina ? 'is-active' : undefined}
              aria-current={chave === pagina ? 'page' : undefined}
            >{t(rotulo)}</a>
          ))}
        </nav>

        <div class="topbar-actions">
          <a class="outline-button action-link" href={acao.destino}>{t(acao.rotulo)}</a>
        </div>

        {/* Seletor de idioma: um link para o mesmo lugar na outra língua, e não
            um botão que troca textos no ar. Assim o endereço em inglês existe,
            pode ser compartilhado e é o que o `hreflang` acima anuncia.
            `data-astro-reload` porque o ClientRouter trocaria só o <body>, e o
            `lang` do <html> — que é quem decide o idioma no cliente — ficaria
            o da página anterior.

            As duas bandeiras ficam lado a lado, separadas por um fio, sem sigla:
            a da página, acesa e sublinhada, e a da outra língua, apagada, que é
            o link. A da página é `aria-hidden` — o leitor de tela já sabe a
            língua pelo <html> — e a do link tem `alt` vazio porque o
            `aria-label` já é uma frase inteira; descrevê-la faria o leitor
            anunciar a bandeira e o rótulo duas vezes. O `title` dá a mesma
            frase a quem passa o mouse, já que a bandeira sozinha não diz a ação. */}
        <div class="idioma-toggle">
          {IDIOMAS.map((idioma, indice) => (
            <Fragment>
              {indice > 0 && <span class="idioma-fio" aria-hidden="true"></span>}
              {idioma.codigo === lang ? (
                <span class="idioma-atual" aria-hidden="true">
                  <img src={`/idiomas/${idioma.bandeira}`} style={`aspect-ratio:${idioma.bandeiraRatio}`} alt="" />
                </span>
              ) : (
                <a
                  href={rota(pagina, idioma.codigo)}
                  lang={idioma.codigo}
                  hreflang={idioma.codigo}
                  data-astro-reload
                  aria-label={idioma.codigo === 'en' ? 'Read this page in English' : 'Ler esta página em português'}
                  title={idioma.codigo === 'en' ? 'Read this page in English' : 'Ler esta página em português'}
                >
                  <img src={`/idiomas/${idioma.bandeira}`} style={`aspect-ratio:${idioma.bandeiraRatio}`} alt="" />
                </a>
              )}
            </Fragment>
          ))}
        </div>

        <!-- Os dois rótulos vivem no HTML e o CSS mostra um por vez: nenhum texto
             é escrito por JS, então não há troca visível depois da pintura. -->
        <button class="vista-toggle" type="button" data-vista-toggle>
          <span class="vista-para-desktop">{t('Ver como no computador')}</span>
          <span class="vista-para-fluxo">{t('Ver versão para celular')}</span>
        </button>
        <button class="menu-button" type="button" aria-expanded="false" aria-label={t('Abrir menu')} data-menu-fechar={t('Fechar')} data-menu-abrir={t('Menu')}>{t('Menu')}</button>
      </div>
    </header>

    <main id="conteudo" class={mainClass}>
      <slot />
    </main>

    {/* Barra inferior do celular e do tablet. Substitui o botão de menu, que
        escondia as rotas atrás de um toque; aqui elas ficam sempre à vista e ao
        alcance do polegar. O CSS decide quando ela aparece — no computador não
        existe. */}
    <nav class="tabbar" aria-label={t('Seções do painel')}>
      {NAVEGACAO.map(({ chave, rotulo, icone }) => (
        <a
          href={rota(chave, lang)}
          class={chave === pagina ? 'is-active' : undefined}
          aria-current={chave === pagina ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icone} /></svg>
          <span>{t(rotulo)}</span>
        </a>
      ))}
    </nav>

    <div class="river-ornament" aria-hidden="true"><i></i><i></i></div>
    <footer>
      <span>{t('Estratégia 2050')}</span>
      <span>{t('Estratégia Amazônia 2050 · Consórcio da Amazônia Legal')}</span>
      {ehTraducao(lang) && (
        <span class="footer-traducao">English is a courtesy translation. The official wording is the Portuguese one.</span>
      )}
    </footer>
  </body>
</html>
