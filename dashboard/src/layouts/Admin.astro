---
// Moldura da administração: barra superior verde-mata com a marca, as seções
// e a conta, e o conteúdo na largura toda da janela, em colunas de texto
// separadas por filetes. Mesmo vocabulário visual do painel público.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/admin.css';
import { caminhoLiberado, inicioDe } from '../lib/admin/usuarios';

interface Props {
  title: string;
  sessao?: { usuario: string; nome: string } | null;
}

const { title, sessao = null } = Astro.props;
const caminho = Astro.url.pathname;

// Uma conta de acesso restrito só vê na barra o que ela abre.
const acesso = Astro.locals.acesso ?? null;
const inicio = inicioDe(acesso);

const TODAS: { grupo: string; itens: { href: string; nome: string; prefixos?: string[] }[] }[] = [
  { grupo: 'Painel', itens: [{ href: '/admin', nome: 'Início' }] },
  { grupo: 'Dados', itens: [
    { href: '/admin/valores', nome: 'Valores' },
    { href: '/admin/propostas', nome: 'Propostas da coleta' }
  ] },
  { grupo: 'Conteúdo', itens: [
    { href: '/admin/catalogo', nome: 'Catálogo', prefixos: ['/admin/fichas'] },
    { href: '/admin/metas', nome: 'Metas' },
    { href: '/admin/textos', nome: 'Textos' },
    { href: '/admin/painel', nome: 'Data e constantes' }
  ] },
  { grupo: 'Configuração', itens: [
    { href: '/admin/panorama', nome: 'Panorama' },
    { href: '/admin/contas', nome: 'Contas' },
    { href: '/admin/ajuda', nome: 'Ajuda' }
  ] }
];

const NAVEGACAO = TODAS
  .map((grupo) => ({ ...grupo, itens: grupo.itens.filter((item) => caminhoLiberado(acesso, item.href)) }))
  .filter((grupo) => grupo.itens.length);

const ativo = (item: { href: string; prefixos?: string[] }) =>
  item.href === '/admin' ? caminho === '/admin' : [item.href, ...(item.prefixos || [])].some((prefixo) => caminho.startsWith(prefixo));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Administração do painel</title>
    <ClientRouter />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Libre+Franklin:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    {sessao ? (
      <div class="admin-app">
        {/* A barra persiste entre as telas: só o conteúdo troca, e o item ativo
            é recalculado a cada navegação (ver o script no fim). */}
        <header class="admin-cabecalho" transition:persist="cabecalho">
          <a class="admin-marca" href={inicio} aria-label="Estratégia Amazônia 2050, início da administração">
            <span class="admin-marca-nome"><span>Estratégia </span>Amazônia <b>2050</b></span>
          </a>
          <button type="button" class="admin-menu-botao" aria-expanded="false" aria-controls="admin-nav" data-abre-nav>Seções</button>
          <nav id="admin-nav" aria-label="Seções da administração">
            {NAVEGACAO.map((grupo) => (
              <div class="admin-nav-grupo" role="group" aria-label={grupo.grupo}>
                <span class="admin-nav-titulo" aria-hidden="true">{grupo.grupo}</span>
                {grupo.itens.map((item) => (
                  <a href={item.href} class={ativo(item) ? 'is-ativo' : undefined} aria-current={ativo(item) ? 'page' : undefined} data-prefixos={item.href === '/admin' ? undefined : [item.href, ...(item.prefixos || [])].join(' ')}>{item.nome}</a>
                ))}
              </div>
            ))}
          </nav>
          <div class="admin-sessao">
            <a class="admin-sessao-publico" href="/" target="_blank" rel="noopener">Painel público ↗</a>
            <span class="admin-sessao-nome">{sessao.nome}</span>
            <a href="/admin/senha">Minha senha</a>
            <form method="post" action="/api/admin/sair"><button type="submit">Sair</button></form>
          </div>
        </header>
        <main class="admin-main" transition:animate="fade">
          <slot />
        </main>
      </div>
    ) : (
      <main class="admin-main is-solta">
        <a class="admin-marca is-escura" href="/">
          <span class="admin-marca-nome">Estratégia Amazônia <b>2050</b></span>
        </a>
        <slot />
      </main>
    )}
    <script is:inline>
      // Sem pré-carregar links aqui: cada tela da administração lê o depósito
      // (na Vercel, a API do GitHub), e o pré-carregamento por viewport do
      // site abriria dezenas de leituras a cada página.
      (function () {
        const marca = () => document.querySelectorAll('a[href]').forEach((link) => { if (!link.dataset.astroPrefetch) link.dataset.astroPrefetch = 'false'; });
        marca();
        document.addEventListener('astro:after-swap', marca);
      })();
    </script>
    <script>
      // A barra persiste entre as telas, então os ouvintes dela são postos uma
      // vez só, no documento: presos ao botão, se acumulariam a cada navegação.
      // Em tela estreita as seções recolhem atrás do botão; clicar fora fecha.
      function fechaNav() {
        document.body.classList.remove('is-nav-aberta');
        document.querySelector('[data-abre-nav]')?.setAttribute('aria-expanded', 'false');
      }
      document.addEventListener('click', (evento) => {
        const alvo = evento.target as HTMLElement;
        const botao = alvo.closest('[data-abre-nav]');
        if (botao) {
          const aberta = document.body.classList.toggle('is-nav-aberta');
          botao.setAttribute('aria-expanded', String(aberta));
        } else if (!alvo.closest('#admin-nav')) fechaNav();
      });
      document.addEventListener('keydown', (evento) => { if (evento.key === 'Escape') fechaNav(); });
      // A barra fica presa no topo; o que gruda abaixo dela precisa saber a
      // altura que ela tem agora (em tela estreita a linha pode quebrar).
      const cabecalho = document.querySelector<HTMLElement>('.admin-cabecalho');
      if (cabecalho) {
        new ResizeObserver(() => document.documentElement.style.setProperty('--adm-cabecalho', `${cabecalho.offsetHeight}px`)).observe(cabecalho);
      }
      // O item ativo é recalculado a cada troca de tela.
      function marcaAtivo() {
        const caminho = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('.admin-nav-grupo a').forEach((link) => {
          const prefixos = link.dataset.prefixos?.split(' ');
          const ativo = prefixos ? prefixos.some((prefixo) => caminho.startsWith(prefixo)) : caminho === '/admin';
          link.classList.toggle('is-ativo', ativo);
          if (ativo) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current');
        });
      }
      document.addEventListener('astro:after-swap', () => {
        fechaNav();
        marcaAtivo();
      });
    </script>
  </body>
</html>
