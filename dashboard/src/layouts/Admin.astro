---
// Moldura da administração, no mesmo vocabulário do painel público: barra
// superior verde-mata com a navegação em texto e o filete ocre na seção
// ativa; conteúdo em colunas de texto separadas por filetes, sem molduras.
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  sessao?: { usuario: string; nome: string } | null;
}

const { title, sessao = null } = Astro.props;
const caminho = Astro.url.pathname;

const NAVEGACAO: { href: string; nome: string; prefixos?: string[] }[] = [
  { href: '/admin', nome: 'Início' },
  { href: '/admin/valores', nome: 'Valores' },
  { href: '/admin/propostas', nome: 'Propostas' },
  { href: '/admin/catalogo', nome: 'Catálogo', prefixos: ['/admin/fichas'] },
  { href: '/admin/metas', nome: 'Metas' },
  { href: '/admin/textos', nome: 'Textos' },
  { href: '/admin/painel', nome: 'Data' },
  { href: '/admin/panorama', nome: 'Panorama' },
  { href: '/admin/contas', nome: 'Contas' },
  { href: '/admin/ajuda', nome: 'Ajuda' }
];

const ativo = (item: { href: string; prefixos?: string[] }) =>
  item.href === '/admin' ? caminho === '/admin' : [item.href, ...(item.prefixos || [])].some((prefixo) => caminho.startsWith(prefixo));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Administração do painel</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Libre+Franklin:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <header class="admin-topo">
      <div class="admin-topo-linha">
        <a class="admin-marca" href="/admin">
          <span class="admin-marca-sub">Administração</span>
          <span class="admin-marca-nome">Estratégia Amazônia <b>2050</b></span>
        </a>
        {sessao && (
          <div class="admin-sessao">
            <span class="admin-sessao-nome">{sessao.nome}</span>
            <a href="/admin/senha">Minha senha</a>
            <a href="/" target="_blank" rel="noopener">Painel público</a>
            <form method="post" action="/api/admin/sair"><button type="submit">Sair</button></form>
          </div>
        )}
      </div>
      {sessao && (
        <nav class="admin-nav" aria-label="Seções da administração">
          {NAVEGACAO.map((item) => (
            <a href={item.href} class={ativo(item) ? 'is-ativo' : undefined} aria-current={ativo(item) ? 'page' : undefined}>{item.nome}</a>
          ))}
        </nav>
      )}
    </header>
    <main class={`admin-main${sessao ? '' : ' is-solta'}`}>
      <slot />
    </main>
  </body>
</html>
