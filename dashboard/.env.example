# Copie para .env. Nenhum destes valores vai para o git.

# Assina o cookie de sessão da administração; 32+ caracteres. Trocar derruba todas as sessões.
SESSION_SECRET=

# Onde a administração grava. Na Vercel: token fine-grained só deste repositório,
# com permissão Contents (leitura e escrita) e Metadata. Sem token, o `astro dev`
# grava direto em conteudo/ (modo local).
GITHUB_TOKEN=
GITHUB_REPO=IcaroGundim/estrategia-amazonia-2050
# Pasta do painel dentro do repositório (padrão: dashboard).
GITHUB_PASTA=dashboard
BRANCH_PRINCIPAL=main
BRANCH_RASCUNHO=rascunho

# Endereço do deploy de prévia da branch de rascunho, para o link "abrir prévia".
PREVIEW_URL=

# Força o modo local mesmo com token (ADMIN_ARMAZENAMENTO=local) ou libera
# "publicar" fora de produção (ADMIN_PERMITE_PUBLICAR=1). Só para desenvolvimento.
ADMIN_ARMAZENAMENTO=
ADMIN_PERMITE_PUBLICAR=
