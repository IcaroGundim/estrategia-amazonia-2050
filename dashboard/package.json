{
  "name": "observatorio-amazonia-2050",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de resultados para os estados da Amazônia Legal.",
  "scripts": {
    "dev": "node build-static.mjs && astro dev",
    "start": "node build-static.mjs && astro dev",
    "build": "node build-static.mjs && node -r ./scripts/shim-cpsync.cjs node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview",
    "build:static": "node build-static.mjs",
    "check:data": "node --check build-static.mjs && node scripts/conferir-derivacao.mjs",
    "check:i18n": "node scripts/conferir-traducao.mjs",
    "nota-tecnica": "node scripts/gerar-nota-tecnica.mjs",
    "usuario": "node scripts/usuario.mjs",
    "portatil": "node portatil/empacotar.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "astro": "^7.2.9",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "katex": "^0.18.5",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
  }
}
