{
  "name": "observatorio-amazonia-2050",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de resultados para os estados da Amazônia Legal.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:static": "node build-static.mjs",
    "check:data": "node --check server.mjs && node --check metas.mjs && node --check build-static.mjs",
    "prepare-data": "node server.mjs --validate",
    "snapshot": "node snapshot.mjs",
    "check:i18n": "node scripts/conferir-traducao.mjs",
    "nota-tecnica": "node scripts/gerar-nota-tecnica.mjs"
  },
  "dependencies": {
    "astro": "^7.2.9",
    "katex": "^0.18.5"
  },
  "devDependencies": {
    "shapefile": "^0.6.6"
  }
}
